---
import { site } from "@/lib/data";
import { url } from "@/lib/url";
import SiteNav from "@/components/SiteNav.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import Lightbox from "@/components/Lightbox.astro";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Absolute or site-relative image used for link previews. */
  image?: string;
}

const { title, description = site.description, image } = Astro.props;
// Without a tagline the front page is just the site name.
const home = site.tagline ? `${site.title} - ${site.tagline}` : site.title;
const pageTitle = title ? `${title} - ${site.shortTitle}` : home;
const canonical = new URL(Astro.url.pathname, Astro.site);
/**
 * A build pointed anywhere but the lab's own domain is a staging copy - the
 * github.io copy used to check a deployment, say - and must stay out of search
 * results, or it competes with the real site for the same words.
 */
const staging = !Astro.site?.host.endsWith("swarmsystemslab.eu");
const preview = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {staging && <meta name="robots" content="noindex, nofollow" />}

    {
      /* The mark, white on black, so it reads in a light or a dark tab strip.
        The PNG is there for browsers that will not take an SVG icon. */
    }
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="alternate icon" href={url("/favicon-32.png")} sizes="32x32" />
    <link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />
    <meta name="theme-color" content="#ffffff" />

    {
      /* Runs before the body is painted, so a visitor who chose the dark theme
        never sees a white flash on the way in. */
    }
    <script is:inline>
      try {
        const saved = localStorage.getItem("theme");
        if (saved === "dark" || saved === "light") document.documentElement.dataset.theme = saved;
      } catch {}
    </script>

    <meta property="og:site_name" content={site.title} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {preview && <meta property="og:image" content={preview} />}
    <meta name="twitter:card" content={preview ? "summary_large_image" : "summary"} />

    <link rel="sitemap" href={url("/sitemap-index.xml")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
  </head>

  <body class="relative min-h-screen">
    <div class="grid-bg pointer-events-none fixed inset-0" aria-hidden="true"></div>

    <div class="relative z-10 flex min-h-screen flex-col">
      <SiteNav />
      <main class="flex-1"><slot /></main>
      <SiteFooter />
    </div>

    <Lightbox />
  </body>
</html>
