---
import { render } from "astro:content";
import Base from "@/layouts/Base.astro";
import { Image } from "astro:assets";
import { getTeam } from "@/lib/collections";
import { url } from "@/lib/url";

export async function getStaticPaths() {
  const members = await getTeam();
  return members
    .filter((entry) => entry.body?.trim())
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.name} description={entry.data.summary} image={entry.data.photo?.src}>
  <article class="mx-auto max-w-3xl px-6 pt-20 pb-16">
    <a href={url("/team")} class="font-display text-[10px] tracking-widest text-accent uppercase">
      ← All team
    </a>

    <header
      class="mt-10 flex flex-col gap-8 border-b border-border pb-10 sm:flex-row sm:items-start"
    >
      {
        entry.data.photo && (
          <Image
            src={entry.data.photo}
            alt={entry.data.name}
            widths={[200, 400]}
            sizes="200px"
            class="w-40 shrink-0 border border-border object-cover"
          />
        )
      }
      <div>
        <div class="font-display text-[10px] tracking-widest text-accent uppercase">
          {entry.data.role}
        </div>
        <h1 class="mt-2 font-display text-3xl font-bold tracking-tighter">{entry.data.name}</h1>
        <p class="mt-4 leading-relaxed text-muted-foreground">{entry.data.summary}</p>
        {
          entry.data.links.length > 0 && (
            <div class="mt-5 flex flex-wrap gap-4 font-display text-[10px] tracking-widest uppercase">
              {entry.data.links.map((l) => (
                <a href={l.href} rel="noopener" class="text-accent">
                  {l.label}
                </a>
              ))}
            </div>
          )
        }
      </div>
    </header>

    <div class="prose-lab mt-10"><Content /></div>
  </article>
</Base>
