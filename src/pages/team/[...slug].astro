---
import { render } from "astro:content";
import Base from "@/layouts/Base.astro";
import Picture from "@/components/Picture.astro";
import { getTeam } from "@/lib/collections";
import { isPanoramic } from "@/lib/images";
import { socialImage } from "@/lib/social-image";
import { url } from "@/lib/url";

export async function getStaticPaths() {
  const members = await getTeam();
  return members
    .filter((member) => member.hasPage)
    .map((member) => ({ params: { slug: member.slug }, props: { member } }));
}

const { member } = Astro.props;
const { entry, photo } = member;
const { Content } = await render(entry);
const hasText = Boolean(entry.body?.trim());

// A passport-style photo sits beside the name; a wide one taken in the field
// would be shrunk to nothing there, so it goes underneath at full width.
const wide = photo ? isPanoramic(photo) : false;
---

<Base title={entry.data.name} description={entry.data.summary} image={await socialImage(photo)}>
  <article class="mx-auto max-w-3xl px-6 pt-20 pb-16">
    <header class="border-b border-border pb-10">
      <div class:list={["flex flex-col gap-8", !wide && "sm:flex-row sm:items-start"]}>
        {
          photo && !wide && (
            <Picture
              src={photo}
              alt={entry.data.name}
              widths={[200, 400]}
              sizes="200px"
              priority
              zoom
              class="w-40 shrink-0 border border-border object-cover"
            />
          )
        }

        <div>
          <div class="font-display text-[10px] tracking-widest text-accent uppercase">
            {entry.data.role}
          </div>
          <h1 class="mt-2 font-display text-3xl font-bold tracking-tighter">{entry.data.name}</h1>
          <p class="mt-4 leading-relaxed text-muted-foreground">{entry.data.summary}</p>
          {
            entry.data.note && (
              <p class="mt-3 font-display text-[10px] tracking-widest text-muted uppercase">
                {entry.data.note}
              </p>
            )
          }
          {
            entry.data.links.length > 0 && (
              <div class="mt-5 flex flex-wrap gap-4 font-display text-[10px] tracking-widest uppercase">
                {entry.data.links.map((l) => (
                  <a href={l.href} rel="noopener" class="text-accent">
                    {l.label}
                  </a>
                ))}
              </div>
            )
          }
        </div>

        {
          photo && wide && (
            <Picture
              src={photo}
              alt={entry.data.name}
              widths={[640, 960, 1280]}
              sizes="(min-width: 768px) 768px, 100vw"
              priority
              zoom
              class="h-auto w-full border border-border"
            />
          )
        }
      </div>
    </header>

    {/* Under the header, where every list page puts its way back. */}
    <a
      href={url("/team")}
      class="mt-10 inline-block font-display text-[10px] tracking-widest text-accent uppercase"
    >
      ← All team
    </a>

    {
      hasText && (
        <div class="prose-lab mt-10">
          <Content />
        </div>
      )
    }
  </article>
</Base>
