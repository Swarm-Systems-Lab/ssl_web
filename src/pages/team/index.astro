---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import Rule from "@/components/Rule.astro";
import Picture from "@/components/Picture.astro";
import Carousel from "@/components/Carousel.astro";
import { getTeam, TEAM_GROUPS, getTeamPhotos } from "@/lib/collections";
import { coverFor } from "@/lib/covers";
import { url } from "@/lib/url";

const members = await getTeam();
const photos = getTeamPhotos();
const shown = TEAM_GROUPS.map((group) => ({
  ...group,
  members: members.filter((m) => m.group === group.key),
})).filter((group) => group.members.length > 0);

// How many photos come before each group, so that "the first few on the page"
// is counted across the whole page rather than restarting at every heading -
// the lead is a group of one, and the row under it is still on screen.
let seen = 0;
const groups = shown.map((group) => {
  const before = seen;
  seen += group.members.length;
  return { ...group, before };
});

/**
 * The whole card is the click target, not just the name. The link stretches
 * over its card with an ::after overlay, which keeps the markup valid - a real
 * link cannot wrap the other links inside a card.
 */
const STRETCH = "after:absolute after:inset-0 after:content-['']";

/**
 * How many pictures are on screen before any scrolling. Those are fetched
 * straight away; everything further down stays lazy, which is the default.
 * With a carousel at the top of the page, the first row of people is not on
 * screen any more and the carousel takes over.
 */
const ABOVE_THE_FOLD = photos.length > 0 ? 0 : 3;
---

<Base title="Team" description="People and visitors of the Swarm Systems Lab.">
  <PageHeader
    page="team"
    eyebrow="Team & visitors"
    title="THE LAB."
    accent="LAB."
    description="Researchers and students working on swarm robotics and autonomous systems, and the colleagues who come to work with us."
  />

  {
    photos.length > 0 && (
      <section class="mx-auto max-w-7xl px-6 pb-14">
        {/* The banner shape page covers use, so the people below are still on
            screen: a tall 16/9 would push them off it. */}
        <Carousel
          slides={photos}
          label="Photos of the lab"
          aspect="aspect-[3/2] sm:aspect-[21/9]"
          widths={[1080, 1440, 1920]}
          sizes="(min-width: 1280px) 1216px, 100vw"
          priority={!coverFor("team")}
        />
      </section>
    )
  }

  <div class="mx-auto max-w-7xl px-6 pb-16">
    {
      groups.map((group) => (
        <section class="mb-16">
          <Rule label={group.label} />

          {group.key === "visitor" ? (
            /* Visitors read as a gallery: two columns, pictures shown wide. */
            <ul class="grid gap-px md:grid-cols-2">
              {group.members.map(({ entry, slug, hasPage, photo }, index) => (
                <li class="relative flex flex-col border border-border bg-surface/30 transition-colors hover:border-accent/50">
                  {photo && (
                    <Picture
                      src={photo}
                      alt={entry.data.name}
                      widths={[960]}
                      sizes="(min-width: 768px) 600px, 100vw"
                      loading={group.before + index < ABOVE_THE_FOLD ? "eager" : "lazy"}
                      class="aspect-video w-full border-b border-border object-cover"
                    />
                  )}
                  <div class="p-6">
                    {entry.data.note && (
                      <div class="font-display text-[10px] tracking-widest text-accent uppercase">
                        {entry.data.note}
                      </div>
                    )}
                    <h3 class="mt-2 font-display text-lg font-bold tracking-tight">
                      {hasPage ? (
                        <a
                          href={url(`/team/${slug}`)}
                          class:list={["transition-colors hover:text-accent", STRETCH]}
                        >
                          {entry.data.name}
                        </a>
                      ) : (
                        entry.data.name
                      )}
                    </h3>
                    <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                      {entry.data.summary}
                    </p>
                  </div>
                </li>
              ))}
            </ul>
          ) : group.key === "alumni" ? (
            <ul class="grid gap-px md:grid-cols-2">
              {group.members.map(({ entry, slug, hasPage, photo }, index) => (
                <li class="relative flex items-start gap-5 border border-border bg-surface/30 p-6 transition-colors hover:border-accent/50">
                  <div class="min-w-0 flex-1">
                    <div class="font-display text-sm font-bold">
                      {hasPage ? (
                        <a
                          href={url(`/team/${slug}`)}
                          class:list={["transition-colors hover:text-accent", STRETCH]}
                        >
                          {entry.data.name}
                        </a>
                      ) : (
                        entry.data.name
                      )}
                    </div>
                    <p class="mt-2 text-sm text-muted-foreground">{entry.data.summary}</p>
                    {entry.data.note && (
                      <p class="mt-2 font-display text-[10px] tracking-widest text-muted uppercase">
                        {entry.data.note}
                      </p>
                    )}
                  </div>

                  {photo && (
                    <Picture
                      src={photo}
                      alt={entry.data.name}
                      widths={[160, 340]}
                      sizes="80px"
                      loading={group.before + index < ABOVE_THE_FOLD ? "eager" : "lazy"}
                      class="size-20 shrink-0 border border-border object-cover"
                    />
                  )}
                </li>
              ))}
            </ul>
          ) : (
            <ul class="grid gap-px sm:grid-cols-2 lg:grid-cols-3">
              {group.members.map(({ entry, slug, hasPage, photo }, index) => (
                <li class="relative flex flex-col border border-border bg-surface/30 transition-colors hover:border-accent/50">
                  {photo && (
                    <Picture
                      src={photo}
                      alt={entry.data.name}
                      widths={[300, 600]}
                      sizes="(min-width: 1024px) 300px, (min-width: 640px) 50vw, 100vw"
                      loading={group.before + index < ABOVE_THE_FOLD ? "eager" : "lazy"}
                      class="aspect-square w-full border-b border-border object-cover"
                    />
                  )}
                  <div class="flex flex-1 flex-col p-6">
                    <div class="font-display text-[10px] tracking-widest text-accent uppercase">
                      {entry.data.role}
                    </div>
                    <h3 class="mt-2 font-display text-lg font-bold tracking-tight">
                      {hasPage ? (
                        <a
                          href={url(`/team/${slug}`)}
                          class:list={["transition-colors hover:text-accent", STRETCH]}
                        >
                          {entry.data.name}
                        </a>
                      ) : (
                        entry.data.name
                      )}
                    </h3>
                    <p class="mt-3 flex-1 text-sm leading-relaxed text-muted-foreground">
                      {entry.data.summary}
                    </p>
                    {entry.data.links.length > 0 && (
                      /* `relative` lifts these above the stretched overlay. */
                      <div class="relative mt-5 flex flex-wrap gap-4 font-display text-[10px] tracking-widest uppercase">
                        {entry.data.links.map((l) => (
                          <a href={l.href} rel="noopener" class="text-muted hover:text-accent">
                            {l.label}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }
  </div>
</Base>
