---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import Carousel from "@/components/Carousel.astro";
import Text from "@/components/Text.astro";
import { awards } from "@/lib/data";
import { picture } from "@/lib/images";
import { hasTransparency } from "@/lib/transparency";
import PeopleList from "@/components/PeopleList.astro";
import ShowMore from "@/components/ShowMore.astro";
import { teamLookup } from "@/lib/collections";
import { url } from "@/lib/url";

const items = [...awards.items].sort((a, b) => b.year - a.year);

// `members` holds either the file name of someone in content/team - in which
// case we show their name - or plain text for anyone not listed there.
const person = await teamLookup();
/**
 * How many awards the page opens with. The rest are in the page too; the
 * script folds them away behind a button.
 */
const AT_FIRST = 10;
/**
 * How many pictures are on screen before any scrolling. Those are fetched
 * straight away; everything further down stays lazy, which is the default.
 */
const ABOVE_THE_FOLD = 2;
---

<Base
  title="Awards"
  description="Grants, prizes, and distinctions awarded to the Swarm Systems Lab."
>
  <PageHeader
    page="awards"
    eyebrow="Recognition"
    title="AWARDS & GRANTS."
    accent="GRANTS."
    description={awards.intro}
  />

  <div class="mx-auto max-w-7xl px-6 pb-16" data-collapsible>
    <ol class="grid border-t border-border sm:grid-cols-2 sm:gap-x-12">
      {
        items.map((item, row) => {
          // One picture or several: `images` wins, `image` is the shorthand.
          const paths = item.images.length > 0 ? item.images : item.image ? [item.image] : [];
          const slides = paths.map((path) => ({
            src: picture(path),
            alt: item.imageAlt ?? item.title,
          }));
          // Artwork with see-through parts would vanish against the dark page,
          // so it sits on a white ground and is shown whole rather than cropped.
          const plate = item.plate ?? paths.some(hasTransparency);
          return (
            <li class="flex flex-col gap-5 border-b border-border py-8 sm:flex-row" data-entry>
              {/* The year keeps the left column whether or not there is a picture. */}
              <span class="w-16 shrink-0 pt-1 font-display text-sm text-accent">{item.year}</span>

              <div class="min-w-0 flex-1">
                <h2 class="font-display text-lg leading-snug font-bold tracking-tight">
                  {item.title}
                </h2>
                <p class="mt-2 font-display text-[10px] tracking-widest text-muted uppercase">
                  {item.awarder}
                </p>

                {item.members.length > 0 && (
                  <p class="mt-3 text-sm text-muted-foreground">
                    Awarded to <PeopleList people={item.members.map(person)} />
                  </p>
                )}

                {item.detail && (
                  <Text
                    text={item.detail}
                    class="mt-3 text-sm leading-relaxed text-muted-foreground"
                  />
                )}

                {item.links.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-4 font-display text-[10px] tracking-widest uppercase">
                    {item.links.map((l) => (
                      <a
                        href={url(l.href)}
                        rel={l.href.startsWith("http") ? "noopener" : undefined}
                        class="text-accent"
                      >
                        {l.label}
                      </a>
                    ))}
                  </div>
                )}
              </div>

              {slides.length > 0 && (
                <Carousel
                  slides={slides}
                  label={`Pictures for ${item.title}`}
                  aspect="aspect-[4/3]"
                  widths={[224, 448]}
                  sizes="(min-width: 640px) 208px, 100vw"
                  loading={row < ABOVE_THE_FOLD ? "eager" : "lazy"}
                  plate={plate}
                  class="w-full shrink-0 self-start sm:w-52"
                />
              )}
            </li>
          );
        })
      }
    </ol>

    {items.length > 0 && <ShowMore limit={AT_FIRST} total={items.length} noun="awards" />}
  </div>
</Base>
