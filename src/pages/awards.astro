---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import Picture from "@/components/Picture.astro";
import Text from "@/components/Text.astro";
import { awards } from "@/lib/data";
import { optionalPicture } from "@/lib/images";
import { getTeam } from "@/lib/collections";
import { url } from "@/lib/url";

const items = [...awards.items].sort((a, b) => b.year - a.year);

// `members` holds either the file name of someone in content/team — in which
// case we show their name — or plain text for anyone not listed there. Only
// people whose file has text under the frontmatter have a page to link to.
const team = new Map(
  (await getTeam()).map((member) => [
    member.slug,
    { name: member.entry.data.name, hasPage: member.hasPage },
  ]),
);
const resolve = (member: string) => {
  const person = team.get(member);
  if (!person) return { label: member, href: undefined };
  return { label: person.name, href: person.hasPage ? url(`/team/${member}`) : undefined };
};
---

<Base
  title="Awards"
  description="Grants, prizes, and distinctions awarded to the Swarm Systems Lab."
>
  <PageHeader
    page="awards"
    eyebrow="Recognition"
    title="AWARDS &"
    accent="GRANTS."
    description={awards.intro}
  />

  <div class="mx-auto max-w-4xl px-6 pb-16">
    <ol class="border-t border-border">
      {
        items.map((item) => {
          const thumb = optionalPicture(item.image);
          return (
            <li class="flex gap-5 border-b border-border py-8">
              {thumb ? (
                <Picture
                  src={thumb}
                  alt={item.imageAlt ?? item.title}
                  widths={[112, 224]}
                  sizes="72px"
                  class="size-18 shrink-0 border border-border object-cover"
                />
              ) : (
                <span class="w-18 shrink-0 pt-1 font-display text-sm text-accent">{item.year}</span>
              )}

              <div class="min-w-0">
                {thumb && <span class="font-display text-sm text-accent">{item.year}</span>}
                <h2 class="font-display text-lg leading-snug font-bold tracking-tight">
                  {item.title}
                </h2>
                <p class="mt-2 font-display text-[10px] tracking-widest text-muted uppercase">
                  {item.awarder}
                </p>

                {item.members.length > 0 && (
                  <p class="mt-3 text-sm text-muted-foreground">
                    Awarded to{" "}
                    {item.members.map((member, index) => {
                      const person = resolve(member);
                      return (
                        <>
                          {index > 0 && ", "}
                          {person.href ? (
                            <a href={person.href} class="text-accent hover:underline">
                              {person.label}
                            </a>
                          ) : (
                            <span class="text-foreground">{person.label}</span>
                          )}
                        </>
                      );
                    })}
                  </p>
                )}

                {item.detail && (
                  <Text
                    text={item.detail}
                    class="mt-3 text-sm leading-relaxed text-muted-foreground"
                  />
                )}
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</Base>
