---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import { awards } from "@/lib/data";

const items = [...awards.items].sort((a, b) => b.year - a.year);
---

<Base
  title="Awards"
  description="Grants, prizes, and distinctions awarded to the Swarm Systems Lab."
>
  <PageHeader eyebrow="Recognition" title="AWARDS &" accent="GRANTS." description={awards.intro} />

  <div class="mx-auto max-w-4xl px-6 pb-16">
    <ol class="border-t border-border">
      {
        items.map((item) => (
          <li class="grid grid-cols-[4rem_1fr] gap-6 border-b border-border py-8">
            <span class="pt-1 font-display text-sm text-accent">{item.year}</span>
            <div>
              <h2 class="font-display text-lg leading-snug font-bold tracking-tight">
                {item.title}
              </h2>
              <p class="mt-2 font-display text-[10px] tracking-widest text-muted uppercase">
                {item.awarder}
              </p>
              {item.detail && (
                <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{item.detail}</p>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</Base>
