---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import Carousel from "@/components/Carousel.astro";
import Text from "@/components/Text.astro";
import { awards } from "@/lib/data";
import { picture } from "@/lib/images";
import { hasTransparency } from "@/lib/transparency";
import { getTeam } from "@/lib/collections";
import { url } from "@/lib/url";

const items = [...awards.items].sort((a, b) => b.year - a.year);

// `members` holds either the file name of someone in content/team - in which
// case we show their name - or plain text for anyone not listed there. Only
// people whose file has text under the frontmatter have a page to link to.
const team = new Map(
  (await getTeam()).map((member) => [
    member.slug,
    { name: member.entry.data.name, hasPage: member.hasPage },
  ]),
);
const resolve = (member: string) => {
  const person = team.get(member);
  if (!person) return { label: member, href: undefined };
  return { label: person.name, href: person.hasPage ? url(`/team/${member}`) : undefined };
};
---

<Base
  title="Awards"
  description="Grants, prizes, and distinctions awarded to the Swarm Systems Lab."
>
  <PageHeader
    page="awards"
    eyebrow="Recognition"
    title="AWARDS & GRANTS."
    accent="GRANTS."
    description={awards.intro}
  />

  <div class="mx-auto max-w-4xl px-6 pb-16">
    <ol class="border-t border-border">
      {
        items.map((item) => {
          // One picture or several: `images` wins, `image` is the shorthand.
          const paths = item.images.length > 0 ? item.images : item.image ? [item.image] : [];
          const slides = paths.map((path) => ({
            src: picture(path),
            alt: item.imageAlt ?? item.title,
          }));
          // Artwork with see-through parts would vanish against the dark page,
          // so it sits on a white ground and is shown whole rather than cropped.
          const plate = item.plate ?? paths.some(hasTransparency);
          return (
            <li class="flex flex-col gap-5 border-b border-border py-8 sm:flex-row">
              {/* The year keeps the left column whether or not there is a picture. */}
              <span class="w-16 shrink-0 pt-1 font-display text-sm text-accent">{item.year}</span>

              <div class="min-w-0 flex-1">
                <h2 class="font-display text-lg leading-snug font-bold tracking-tight">
                  {item.title}
                </h2>
                <p class="mt-2 font-display text-[10px] tracking-widest text-muted uppercase">
                  {item.awarder}
                </p>

                {item.members.length > 0 && (
                  <p class="mt-3 text-sm text-muted-foreground">
                    Awarded to{" "}
                    {item.members.map((member, index) => {
                      const person = resolve(member);
                      return (
                        <>
                          {index > 0 && ", "}
                          {person.href ? (
                            <a href={person.href} class="text-accent hover:underline">
                              {person.label}
                            </a>
                          ) : (
                            <span class="text-foreground">{person.label}</span>
                          )}
                        </>
                      );
                    })}
                  </p>
                )}

                {item.detail && (
                  <Text
                    text={item.detail}
                    class="mt-3 text-sm leading-relaxed text-muted-foreground"
                  />
                )}

                {item.links.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-4 font-display text-[10px] tracking-widest uppercase">
                    {item.links.map((l) => (
                      <a
                        href={url(l.href)}
                        rel={l.href.startsWith("http") ? "noopener" : undefined}
                        class="text-accent"
                      >
                        {l.label}
                      </a>
                    ))}
                  </div>
                )}
              </div>

              {slides.length > 0 && (
                <Carousel
                  slides={slides}
                  label={`Pictures for ${item.title}`}
                  aspect="aspect-[4/3]"
                  widths={[320, 640]}
                  sizes="(min-width: 640px) 288px, 100vw"
                  plate={plate}
                  class="w-full shrink-0 sm:w-72"
                />
              )}
            </li>
          );
        })
      }
    </ol>
  </div>
</Base>
