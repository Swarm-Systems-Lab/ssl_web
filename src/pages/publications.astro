---
import Page from "@/layouts/Page.astro";
import PublicationEntry from "@/components/PublicationEntry.astro";
import ShowMore from "@/components/ShowMore.astro";
import FilterBar from "@/components/FilterBar.astro";
import { publications, publicationKinds, type Publication, pageText, label } from "@/lib/data";

/**
 * Three zones. Work under review comes first - it is the most recent thing we
 * have to say, and its year is the year it was submitted, not published.
 * Published work follows, grouped by year. Tech notes come last: they live on
 * arXiv and were never headed for a journal, so they do not belong in the
 * chronology of published work.
 */
const text = pageText("publications");

const inReview = publications.filter((entry) => entry.kind === "preprint");
const notes = publications.filter((entry) => entry.kind === "technote");

const byYear = (() => {
  const groups = new Map<number, Publication[]>();
  for (const entry of publications) {
    if (entry.kind === "preprint" || entry.kind === "technote") continue;
    const key = entry.year ?? 0;
    groups.set(key, [...(groups.get(key) ?? []), entry]);
  }
  return [...groups.entries()].sort((a, b) => b[0] - a[0]);
})();

const sections: { title: string; items: Publication[] }[] = [
  { title: label(text, "in-review", "publications"), items: inReview },
  ...byYear.map(([year, items]) => ({ title: String(year), items })),
  { title: label(text, "tech-notes", "publications"), items: notes },
].filter((section) => section.items.length > 0);

const options = publicationKinds.map(({ key, label }) => ({
  value: key,
  label,
  count: publications.filter((entry) => entry.kind === key).length,
}));
/** How many papers the page opens with, of whatever the filter is showing. */
const AT_FIRST = 30;

/**
 * How many pictures are on screen before any scrolling. Those are fetched
 * straight away; everything further down stays lazy, which is the default.
 */
const ABOVE_THE_FOLD = 4;
---

<Page name="publications">
  <div class="mx-auto max-w-7xl px-6 pb-16" data-filterable data-collapsible>
    <FilterBar options={options} allLabel="Everything" class="mb-14 border-y border-border py-4" />

    {
      sections.map(({ title, items }, section) => (
        <section class="mb-16" data-filter-group>
          <div class="mb-8 flex items-baseline gap-4">
            <h2 class="font-display text-3xl font-bold tracking-tighter">{title}</h2>
            <div class="h-px flex-1 bg-border" />
          </div>

          <ol class="space-y-8">
            {items.map((pub, index) => (
              <PublicationEntry
                pub={pub}
                loading={section === 0 && index < ABOVE_THE_FOLD ? "eager" : "lazy"}
              />
            ))}
          </ol>
        </section>
      ))
    }

    <ShowMore
      limit={AT_FIRST}
      total={publications.length}
      noun={label(text, "more", "publications")}
    />
  </div>
</Page>
