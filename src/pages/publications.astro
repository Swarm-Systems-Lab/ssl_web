---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import Picture from "@/components/Picture.astro";
import FilterBar from "@/components/FilterBar.astro";
import { publications, publicationKinds, type Publication } from "@/lib/data";
import { optionalPicture } from "@/lib/images";
import { url } from "@/lib/url";

// Primary grouping is the year; the kind is a filter on top of it.
// Papers with no year (preprints, work in review) sort to the front.
const groups = (() => {
  const byYear = new Map<number, Publication[]>();
  for (const entry of publications) {
    const key = entry.year ?? 0;
    byYear.set(key, [...(byYear.get(key) ?? []), entry]);
  }
  // Work still in review sits above the published years, not below 2010.
  const rank = (year: number) => (year === 0 ? Infinity : year);
  return [...byYear.entries()].sort((a, b) => rank(b[0]) - rank(a[0]));
})();

const options = publicationKinds.map(({ key, label }) => ({
  value: key,
  label,
  count: publications.filter((entry) => entry.kind === key).length,
}));
---

<Base
  title="Publications"
  description="Journal and conference publications of the Swarm Systems Lab."
>
  <PageHeader
    page="publications"
    eyebrow="Archive"
    title="PUBLICATIONS."
    accent=""
    description="Peer-reviewed work in IEEE Transactions on Automatic Control, Transactions on Robotics, Automatica, ICRA, IROS, CDC, and IFAC."
  />

  <div class="mx-auto max-w-7xl px-6 pb-16" data-filterable>
    <FilterBar options={options} allLabel="Everything" class="mb-14 border-y border-border py-4" />

    {
      groups.map(([year, items]) => (
        <section class="mb-16" data-filter-group>
          <div class="mb-8 flex items-baseline gap-4">
            <h2 class="font-display text-3xl font-bold tracking-tighter">
              {year > 0 ? year : "In review"}
            </h2>
            <div class="h-px flex-1 bg-border" />
          </div>

          <ol class="space-y-8">
            {items.map((pub) => {
              const thumb = optionalPicture(pub.image);
              return (
                <li class="flex gap-5" data-kind={pub.kind}>
                  {/* The reference number always stays on the left. */}
                  <span class="w-12 shrink-0 pt-1 font-display text-xs text-muted">
                    [{pub.ref}]
                  </span>

                  <div class="min-w-0 flex-1">
                    <h3 class="font-display text-base leading-snug font-medium">
                      <a
                        href={url(`/publications/${pub.slug}`)}
                        class="transition-colors hover:text-accent"
                      >
                        {pub.title}
                      </a>
                    </h3>
                    <p class="mt-2 text-sm text-muted-foreground">
                      {pub.authors} · <span class="text-foreground italic">{pub.venue}</span>
                    </p>
                    <div class="mt-3 flex flex-wrap items-center gap-4 font-display text-[10px] tracking-widest uppercase">
                      <span class="border border-border px-2 py-0.5 text-muted">
                        {pub.kindLabel}
                      </span>
                      {pub.links.map((l) => (
                        <a href={l.href} rel="noopener" class="text-accent">
                          {l.label}
                        </a>
                      ))}
                    </div>
                    {pub.note && (
                      <p class="mt-3 font-display text-[10px] tracking-widest text-accent uppercase">
                        {pub.note}
                      </p>
                    )}
                  </div>

                  {thumb && (
                    <a href={url(`/publications/${pub.slug}`)} class="shrink-0">
                      <Picture
                        src={thumb}
                        alt={pub.imageAlt ?? pub.title}
                        widths={[160, 320]}
                        sizes="96px"
                        class="size-24 border border-border object-cover transition-colors hover:border-accent/50"
                      />
                    </a>
                  )}
                </li>
              );
            })}
          </ol>
        </section>
      ))
    }
  </div>
</Base>
