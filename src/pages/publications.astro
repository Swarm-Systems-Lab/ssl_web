---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import Picture from "@/components/Picture.astro";
import FilterBar from "@/components/FilterBar.astro";
import { publications, publicationKinds, type Publication } from "@/lib/data";
import { optionalPicture } from "@/lib/images";
import { url } from "@/lib/url";

/**
 * Three zones. Work under review comes first — it is the most recent thing we
 * have to say, and its year is the year it was submitted, not published.
 * Published work follows, grouped by year. Tech notes come last: they live on
 * arXiv and were never headed for a journal, so they do not belong in the
 * chronology of published work.
 */
const inReview = publications.filter((entry) => entry.kind === "preprint");
const notes = publications.filter((entry) => entry.kind === "technote");

const byYear = (() => {
  const groups = new Map<number, Publication[]>();
  for (const entry of publications) {
    if (entry.kind === "preprint" || entry.kind === "technote") continue;
    const key = entry.year ?? 0;
    groups.set(key, [...(groups.get(key) ?? []), entry]);
  }
  return [...groups.entries()].sort((a, b) => b[0] - a[0]);
})();

const sections: { title: string; items: Publication[] }[] = [
  { title: "In review", items: inReview },
  ...byYear.map(([year, items]) => ({ title: String(year), items })),
  { title: "Tech notes", items: notes },
].filter((section) => section.items.length > 0);

const options = publicationKinds.map(({ key, label }) => ({
  value: key,
  label,
  count: publications.filter((entry) => entry.kind === key).length,
}));
/**
 * How many pictures are on screen before any scrolling. Those are fetched
 * straight away; everything further down stays lazy, which is the default.
 */
const ABOVE_THE_FOLD = 4;
---

<Base
  title="Publications"
  description="Journal and conference publications of the Swarm Systems Lab."
>
  <PageHeader
    page="publications"
    eyebrow="Archive"
    title="PUBLICATIONS."
    accent=""
    description="Peer-reviewed work in IEEE Transactions on Automatic Control, Transactions on Robotics, Automatica, ICRA, IROS, CDC, and IFAC."
  />

  <div class="mx-auto max-w-7xl px-6 pb-16" data-filterable>
    <FilterBar options={options} allLabel="Everything" class="mb-14 border-y border-border py-4" />

    {
      sections.map(({ title, items }, section) => (
        <section class="mb-16" data-filter-group>
          <div class="mb-8 flex items-baseline gap-4">
            <h2 class="font-display text-3xl font-bold tracking-tighter">{title}</h2>
            <div class="h-px flex-1 bg-border" />
          </div>

          <ol class="space-y-8">
            {items.map((pub, index) => {
              const thumb = optionalPicture(pub.image);
              return (
                <li class="flex gap-5" data-kind={pub.kind}>
                  {/* The reference number always stays on the left. */}
                  <span class="w-12 shrink-0 pt-1 font-display text-xs text-muted">
                    [{pub.ref}]
                  </span>

                  <div class="min-w-0 flex-1">
                    <h3 class="font-display text-base leading-snug font-medium">
                      <a
                        href={url(`/publications/${pub.slug}`)}
                        class="transition-colors hover:text-accent"
                      >
                        {pub.title}
                      </a>
                    </h3>
                    <p class="mt-2 text-sm text-muted-foreground">
                      {pub.authors} · <span class="text-foreground italic">{pub.venue}</span>
                    </p>
                    <div class="mt-3 flex flex-wrap items-center gap-4 font-display text-[10px] tracking-widest uppercase">
                      <span class="border border-border px-2 py-0.5 text-muted">
                        {pub.kindLabel}
                      </span>
                      {pub.links.map((l) => (
                        <a href={l.href} rel="noopener" class="text-accent">
                          {l.label}
                        </a>
                      ))}
                    </div>
                    {pub.note && (
                      <p class="mt-3 font-display text-[10px] tracking-widest text-accent uppercase">
                        {pub.note}
                      </p>
                    )}
                  </div>

                  {thumb && (
                    <a href={url(`/publications/${pub.slug}`)} class="shrink-0">
                      <Picture
                        src={thumb}
                        alt={pub.imageAlt ?? pub.title}
                        widths={[96, 192]}
                        sizes="96px"
                        loading={section === 0 && index < ABOVE_THE_FOLD ? "eager" : "lazy"}
                        class="size-24 border border-border object-cover transition-colors hover:border-accent/50"
                      />
                    </a>
                  )}
                </li>
              );
            })}
          </ol>
        </section>
      ))
    }
  </div>
</Base>
