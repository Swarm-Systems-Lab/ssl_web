---
import Page from "@/layouts/Page.astro";
import ApplyBox from "@/components/ApplyBox.astro";
import { positions, studentProjects, pageText, label } from "@/lib/data";
import { url } from "@/lib/url";

// The landing page for the two ways into the lab. The lists themselves live on
// their own pages so each can be linked to on its own.
const text = pageText("join-us");

/*
 * "2 openings listed". Both the noun and the word after it come from
 * pages.yaml, singular and plural spelled out rather than an "s" appended: a
 * language that does not form plurals that way would otherwise need this file
 * opened rather than translated.
 */
const listed = (count: number, unit: string) =>
  `${count} ${label(text, count === 1 ? unit : `${unit}s`, "join-us")} ${label(text, "listed", "join-us")}`;

// Where each card goes and what it counts is the page's business; what it says
// comes from pages.yaml, in the same order.
const destinations = [
  { href: "/join-us/positions", count: positions.items.length, unit: "opening" },
  { href: "/join-us/student-projects", count: studentProjects.items.length, unit: "project" },
];

if ((text.cards ?? []).length !== destinations.length) {
  throw new Error(
    `content/pages.yaml: "join-us" needs ${destinations.length} cards, ` +
      `and has ${(text.cards ?? []).length}.\n`,
  );
}

const routes = destinations.map((destination, index) => ({
  ...destination,
  ...text.cards![index],
}));
---

<Page name="join-us">
  <div class="mx-auto max-w-7xl px-6 pb-16">
    <ul class="grid gap-px md:grid-cols-2">
      {
        routes.map((route) => (
          <li class="relative flex flex-col border border-border bg-surface/30 p-10 transition-colors hover:border-accent/50">
            <div class="font-display text-[10px] tracking-widest text-accent uppercase">
              {route.eyebrow}
            </div>
            <h2 class="mt-3 font-display text-2xl font-bold tracking-tight">
              <a
                href={url(route.href)}
                class="transition-colors after:absolute after:inset-0 after:content-[''] hover:text-accent"
              >
                {route.title}
              </a>
            </h2>
            <p class="mt-4 flex-1 text-sm leading-relaxed text-muted-foreground">{route.body}</p>
            <div class="mt-8 flex items-center justify-between border-t border-border pt-6 font-display text-[10px] tracking-widest uppercase">
              <span class="text-muted">{listed(route.count, route.unit)}</span>
              <span class="text-accent">See them →</span>
            </div>
          </li>
        ))
      }
    </ul>

    <ApplyBox class="mt-16" />
  </div>
</Page>
