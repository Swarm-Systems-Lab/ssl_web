---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import ApplyBox from "@/components/ApplyBox.astro";
import { positions, projects } from "@/lib/data";
import { url } from "@/lib/url";

// The landing page for the two ways into the lab. The lists themselves live on
// their own pages so each can be linked to on its own.
const listed = (count: number, unit: string) => `${count} ${unit}${count === 1 ? "" : "s"} listed`;

const routes = [
  {
    href: "/join-us/positions",
    eyebrow: "Researchers",
    title: "Open positions",
    count: positions.items.length,
    unit: "opening",

    body: "Ph.D. and postdoctoral fellowships, visiting researchers, and the funding schemes we can support you through.",
  },
  {
    href: "/join-us/projects",
    eyebrow: "Students",
    title: "Master & bachelor projects",
    count: projects.items.length,
    unit: "project",

    body: "TFM and TFG topics on guiding vector fields, distributed algorithms, onboard navigation, and the tools behind our experiments.",
  },
];
---

<Base
  title="Join us"
  description="Open positions and student projects at the Swarm Systems Lab, University of Granada."
>
  <PageHeader
    page="join-us"
    eyebrow="Now recruiting"
    title="JOIN THE SWARM."
    accent="SWARM."
    description="We run a lab with diverse but strong theoretical and practical backgrounds. If your profile does not fit an offer but you think you are a good match, get in touch anyway."
  />

  <div class="mx-auto max-w-7xl px-6 pb-16">
    <ul class="grid gap-px md:grid-cols-2">
      {
        routes.map((route) => (
          <li class="relative flex flex-col border border-border bg-surface/30 p-10 transition-colors hover:border-accent/50">
            <div class="font-display text-[10px] tracking-widest text-accent uppercase">
              {route.eyebrow}
            </div>
            <h2 class="mt-3 font-display text-2xl font-bold tracking-tight">
              <a
                href={url(route.href)}
                class="transition-colors after:absolute after:inset-0 after:content-[''] hover:text-accent"
              >
                {route.title}
              </a>
            </h2>
            <p class="mt-4 flex-1 text-sm leading-relaxed text-muted-foreground">{route.body}</p>
            <div class="mt-8 flex items-center justify-between border-t border-border pt-6 font-display text-[10px] tracking-widest uppercase">
              <span class="text-muted">{listed(route.count, route.unit)}</span>
              <span class="text-accent">See them →</span>
            </div>
          </li>
        ))
      }
    </ul>

    <ApplyBox class="mt-16" />
  </div>
</Base>
