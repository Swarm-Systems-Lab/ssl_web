---
import { render } from "astro:content";
import Base from "@/layouts/Base.astro";
import Picture from "@/components/Picture.astro";
import Carousel from "@/components/Carousel.astro";
import Logo from "@/components/Logo.astro";
import Rule from "@/components/Rule.astro";
import PublicationEntry from "@/components/PublicationEntry.astro";
import PeopleList from "@/components/PeopleList.astro";
import { getResearch, researchMedia, worksByRef, teamLookup, backerLabel } from "@/lib/collections";
import { socialImage } from "@/lib/social-image";
import { url } from "@/lib/url";

export async function getStaticPaths() {
  const topics = await getResearch();
  return topics.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const { header, slides } = researchMedia(entry);
const { data } = entry;

// Papers are named by reference, so a project never restates what
// publications.yaml already holds.
const works = worksByRef(data.works, `content/research/${entry.id}/index.md`);
const person = await teamLookup();
const people = data.members.map(person);

// The fact sheet is only worth drawing when there is a fact to put in it.
const facts =
  data.funding.length +
  data.partners.length +
  data.links.length +
  people.length +
  (data.period ? 1 : 0);
---

<Base title={entry.data.title} description={entry.data.summary} image={await socialImage(header)}>
  <article class="mx-auto max-w-3xl px-6 pt-20 pb-16">
    <header class="border-b border-border pb-10">
      <div
        class="mb-4 flex flex-wrap items-center gap-3 font-display text-[10px] tracking-widest uppercase"
      >
        {
          data.acronym && (
            <span class="border border-accent/30 px-2 py-1 text-accent">{data.acronym}</span>
          )
        }
        {
          data.tags.length > 0 && (
            <span class="text-accent">{data.tags.map((tag) => `#${tag}`).join(" ")}</span>
          )
        }
      </div>
      <h1 class="font-display text-3xl leading-tight font-bold tracking-tighter md:text-4xl">
        {entry.data.title}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-muted-foreground">{entry.data.summary}</p>
    </header>

    {/* Under the header, where every list page puts its way back. */}
    <a
      href={url("/research")}
      class="mt-10 inline-block font-display text-[10px] tracking-widest text-accent uppercase"
    >
      ← All research
    </a>

    {
      header && (
        <Picture
          src={header}
          alt={entry.data.imageAlt ?? entry.data.title}
          widths={[640, 960, 1280]}
          sizes="(min-width: 768px) 768px, 100vw"
          priority
          zoom
          class="mt-10 w-full border border-border"
        />
      )
    }

    {
      facts > 0 && (
        <dl class="mt-10 divide-y divide-border border border-border bg-surface/30">
          {[
            { term: "Funding", backers: data.funding },
            { term: "Partners", backers: data.partners },
          ]
            .filter((row) => row.backers.length > 0)
            .map((row) => (
              <div class="flex flex-col gap-4 p-6 sm:flex-row sm:gap-8">
                <dt class="shrink-0 font-display text-[10px] tracking-widest text-muted uppercase sm:w-28 sm:pt-1">
                  {row.term}
                </dt>
                <dd class="min-w-0 flex-1 space-y-4">
                  {row.backers.map((backer) => (
                    <div class="flex items-start gap-4">
                      {backer.logo && (
                        <Logo
                          label={backer.name}
                          name={backer.logo}
                          folder="affiliations"
                          size="h-8 w-auto max-w-24"
                          widths={[96, 192]}
                          sizes="96px"
                          class="shrink-0"
                        />
                      )}
                      <div class="min-w-0">
                        <div class="font-medium">
                          {backer.href ? (
                            <a
                              href={backer.href}
                              rel="noopener"
                              class="transition-colors hover:text-accent"
                            >
                              {backerLabel(backer)}
                            </a>
                          ) : (
                            backerLabel(backer)
                          )}
                        </div>
                        {backer.reference && (
                          <div class="mt-1 font-display text-[10px] tracking-widest text-muted uppercase">
                            Ref {backer.reference}
                          </div>
                        )}
                      </div>
                    </div>
                  ))}
                </dd>
              </div>
            ))}

          {data.period && (
            <div class="flex flex-col gap-4 p-6 sm:flex-row sm:gap-8">
              <dt class="shrink-0 font-display text-[10px] tracking-widest text-muted uppercase sm:w-28">
                Running
              </dt>
              <dd class="flex-1">{data.period}</dd>
            </div>
          )}

          {data.links.length > 0 && (
            <div class="flex flex-col gap-4 p-6 sm:flex-row sm:gap-8">
              <dt class="shrink-0 font-display text-[10px] tracking-widest text-muted uppercase sm:w-28">
                Elsewhere
              </dt>
              <dd class="flex flex-1 flex-wrap gap-x-6 gap-y-2">
                {data.links.map((item) => (
                  <a
                    href={item.href}
                    rel="noopener"
                    class="text-accent transition-colors hover:underline"
                  >
                    {item.label} →
                  </a>
                ))}
              </dd>
            </div>
          )}

          {people.length > 0 && (
            <div class="flex flex-col gap-4 p-6 sm:flex-row sm:gap-8">
              <dt class="shrink-0 font-display text-[10px] tracking-widest text-muted uppercase sm:w-28">
                Team
              </dt>
              <dd class="flex-1">
                <PeopleList people={people} />
              </dd>
            </div>
          )}
        </dl>
      )
    }

    <div class="prose-lab mt-10"><Content /></div>

    {
      slides.length > 0 && (
        <Carousel
          slides={slides}
          label={`Pictures for ${entry.data.title}`}
          class="mt-12"
          sizes="(min-width: 768px) 768px, 100vw"
        />
      )
    }

    {
      works.length > 0 && (
        <section class="mt-14">
          <Rule
            label={works.length === 1 ? "Paper from this project" : "Papers from this project"}
          />
          <ol class="space-y-8">
            {works.map((pub) => (
              <PublicationEntry pub={pub} />
            ))}
          </ol>
        </section>
      )
    }
  </article>
</Base>
