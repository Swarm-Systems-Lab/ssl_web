---
import { render } from "astro:content";
import Base from "@/layouts/Base.astro";
import Picture from "@/components/Picture.astro";
import Carousel from "@/components/Carousel.astro";
import { getResearch, researchPictures } from "@/lib/collections";
import { socialImage } from "@/lib/social-image";
import { url } from "@/lib/url";

export async function getStaticPaths() {
  const topics = await getResearch();
  return topics.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const { header, slides } = researchPictures(entry);
---

<Base title={entry.data.title} description={entry.data.summary} image={await socialImage(header)}>
  <article class="mx-auto max-w-3xl px-6 pt-20 pb-16">
    <a
      href={url("/research")}
      class="font-display text-[10px] tracking-widest text-accent uppercase"
    >
      ← All research
    </a>

    <header class="mt-10 border-b border-border pb-10">
      {
        entry.data.tags.length > 0 && (
          <div class="mb-4 font-display text-[10px] tracking-widest text-accent uppercase">
            {entry.data.tags.map((tag) => `#${tag}`).join(" ")}
          </div>
        )
      }
      <h1 class="font-display text-3xl leading-tight font-bold tracking-tighter md:text-4xl">
        {entry.data.title}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-muted-foreground">{entry.data.summary}</p>
    </header>

    {
      header && (
        <Picture
          src={header}
          alt={entry.data.imageAlt ?? entry.data.title}
          widths={[640, 960, 1280]}
          sizes="(min-width: 768px) 768px, 100vw"
          loading="eager"
          class="mt-10 w-full border border-border"
        />
      )
    }

    <div class="prose-lab mt-10"><Content /></div>

    {
      slides.length > 0 && (
        <Carousel
          slides={slides}
          label={`Pictures for ${entry.data.title}`}
          class="mt-12"
          sizes="(min-width: 768px) 768px, 100vw"
        />
      )
    }
  </article>
</Base>
