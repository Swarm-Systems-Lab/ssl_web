---
import { render } from "astro:content";
import Base from "@/layouts/Base.astro";
import { Image } from "astro:assets";
import { getResearch } from "@/lib/collections";
import { url } from "@/lib/url";

export async function getStaticPaths() {
  const topics = await getResearch();
  return topics.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.summary} image={entry.data.image?.src}>
  <article class="mx-auto max-w-3xl px-6 pt-20 pb-16">
    <a
      href={url("/research")}
      class="font-display text-[10px] tracking-widest text-accent uppercase"
    >
      ← All research
    </a>

    <header class="mt-10 border-b border-border pb-10">
      {
        entry.data.tags.length > 0 && (
          <div class="mb-4 font-display text-[10px] tracking-widest text-accent uppercase">
            {entry.data.tags.map((tag) => `#${tag}`).join(" ")}
          </div>
        )
      }
      <h1 class="font-display text-3xl leading-tight font-bold tracking-tighter md:text-4xl">
        {entry.data.title}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-muted-foreground">{entry.data.summary}</p>
    </header>

    {
      entry.data.image && (
        <Image
          src={entry.data.image}
          alt={entry.data.imageAlt ?? entry.data.title}
          widths={[640, 960, 1280]}
          sizes="(min-width: 768px) 768px, 100vw"
          class="mt-10 w-full border border-border"
        />
      )
    }

    <div class="prose-lab mt-10"><Content /></div>
  </article>
</Base>
