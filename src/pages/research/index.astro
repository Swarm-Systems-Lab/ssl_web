---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import { Image } from "astro:assets";
import { getResearch } from "@/lib/collections";
import { url } from "@/lib/url";

const topics = await getResearch();
---

<Base
  title="Research"
  description="Swarm robotics, guiding vector fields, formation control, and distributed coordination."
>
  <PageHeader
    eyebrow="Research"
    title="WHAT WE"
    accent="WORK ON."
    description="Control theory and emergent behaviour, from formal guarantees on paper to swarms of fixed-wing aircraft, rotorcraft, and rovers in the field."
  />

  <section class="mx-auto grid max-w-7xl gap-px px-6 pb-16 md:grid-cols-2 lg:grid-cols-3">
    {
      topics.map((topic) => (
        <article class="flex flex-col border border-border bg-surface/30 transition-colors hover:border-accent/50">
          {topic.data.image && (
            <Image
              src={topic.data.image}
              alt={topic.data.imageAlt ?? topic.data.title}
              widths={[400, 800]}
              sizes="(min-width: 1024px) 400px, (min-width: 768px) 50vw, 100vw"
              class="aspect-video w-full border-b border-border object-cover"
            />
          )}
          <div class="flex flex-1 flex-col p-6">
            <h2 class="font-display text-base font-bold">
              <a href={url(`/research/${topic.id}`)} class="transition-colors hover:text-accent">
                {topic.data.title}
              </a>
            </h2>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-muted-foreground">
              {topic.data.summary}
            </p>
            {topic.data.tags.length > 0 && (
              <div class="mt-5 font-display text-[10px] tracking-widest text-accent uppercase">
                {topic.data.tags.map((tag) => `#${tag}`).join(" ")}
              </div>
            )}
          </div>
        </article>
      ))
    }
    {topics.length === 0 && <p class="text-muted-foreground">No research topics yet.</p>}
  </section>
</Base>
