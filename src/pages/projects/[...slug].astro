---
import { render } from "astro:content";
import Base from "@/layouts/Base.astro";
import Picture from "@/components/Picture.astro";
import PublicationEntry from "@/components/PublicationEntry.astro";
import Rule from "@/components/Rule.astro";
import { getProjects, worksByRef, REPO_GROUPS } from "@/lib/collections";
import { pageText, label } from "@/lib/data";
import { socialImage } from "@/lib/social-image";
import { url } from "@/lib/url";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects
    .filter((project) => project.hasPage)
    .map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const { entry, cover, slug } = project;
const { Content } = await render(entry);
const hasText = Boolean(entry.body?.trim());
const text = pageText("projects");

const papers = worksByRef(entry.data.works, `content/projects/${slug}/index.md`);

// The repos a project is made of, in blocks. `needs` names other repos in the
// same list, so the chain is drawn without repeating any of it. A block with
// nothing in it is left out, so a project with only core repos shows no
// headings at all and reads exactly as it did before there were any.
const blocks = REPO_GROUPS.map((group) => ({
  ...group,
  repos: entry.data.repos.filter((repo) => repo.group === group.key),
})).filter((block) => block.repos.length > 0);
const onlyBlock = blocks.length === 1;

// Only the labels are wanted here, not the section's header: a project page
// reads as its own entry, the way a post or a person does, not as the projects
// page with something underneath it.
---

<Base title={entry.data.title} description={entry.data.summary} image={await socialImage(cover)}>
  <article class="mx-auto max-w-3xl px-6 pt-20 pb-16">
    <header class="border-b border-border pb-10">
      <h1
        class="mt-2 flex flex-wrap items-baseline gap-3 font-display text-3xl font-bold tracking-tighter"
      >
        {entry.data.title}
        {
          entry.data.status && (
            <span class="font-display text-[10px] tracking-widest text-muted uppercase">
              {entry.data.status}
            </span>
          )
        }
      </h1>
      <div class="font-display text-[10px] tracking-widest text-accent uppercase">
        {entry.data.role}
      </div>
      <p class="mt-4 leading-relaxed text-muted-foreground">{entry.data.summary}</p>

      {
        entry.data.links.length > 0 && (
          <div class="mt-6 flex flex-wrap gap-3">
            {entry.data.links.map((l) => (
              <a
                href={l.href}
                rel="noopener"
                class="border border-accent/30 px-2 py-1 font-display text-[10px] tracking-widest text-accent uppercase transition-colors hover:bg-accent/10"
              >
                {l.label}
              </a>
            ))}
          </div>
        )
      }

      {
        cover && (
          <Picture
            src={cover}
            alt={entry.data.imageAlt ?? entry.data.title}
            widths={[640, 960, 1280]}
            sizes="(min-width: 768px) 768px, 100vw"
            priority
            zoom
            class="mt-8 h-auto w-full border border-border"
          />
        )
      }
    </header>

    {/* Under the header, where every list page puts its way back. */}
    <a
      href={url("/projects")}
      class="mt-10 inline-block font-display text-[10px] tracking-widest text-accent uppercase"
    >
      ← {label(text, "back", "projects")}
    </a>

    {
      hasText && (
        <div class="prose-lab mt-10">
          <Content />
        </div>
      )
    }

    {
      blocks.length > 0 && (
        <section class="mt-14">
          <Rule label={label(text, "parts", "projects")} />

          {blocks.map((block) => (
            <div class="mb-10 last:mb-0">
              {!onlyBlock && (
                <h3 class="mb-3 font-display text-[10px] tracking-widest text-muted uppercase">
                  {block.label}
                </h3>
              )}

              <ul class="grid border-t border-border">
                {block.repos.map((repo) => (
                  <li class="border-b border-border py-5">
                    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                      <a
                        href={repo.href}
                        rel="noopener"
                        class="font-display text-sm font-bold text-accent"
                      >
                        {repo.name}
                      </a>
                      {repo.needs.length > 0 && (
                        <span class="font-display text-[10px] tracking-widest text-muted uppercase">
                          {label(text, "needs", "projects")} {repo.needs.join(", ")}
                        </span>
                      )}
                    </div>
                    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{repo.role}</p>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      )
    }

    {
      papers.length > 0 && (
        <section class="mt-14">
          <Rule label={label(text, "papers", "projects")} />
          <ol class="grid gap-8">
            {papers.map((paper) => (
              <PublicationEntry pub={paper} />
            ))}
          </ol>
        </section>
      )
    }
  </article>
</Base>
