---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import { projects, site } from "@/lib/data";
---

<Base
  title="Student projects"
  description="Master (TFM) and bachelor (TFG) projects offered by the Swarm Systems Lab."
>
  <PageHeader eyebrow="TFM / TFG" title="STUDENT" accent="PROJECTS." description={projects.intro} />

  <div class="mx-auto max-w-7xl px-6 pb-16">
    <ul class="grid gap-px md:grid-cols-2">
      {
        projects.items.map((item) => (
          <li class="flex flex-col border border-border bg-surface/30 p-8 transition-colors hover:border-accent/50">
            <span class="self-start border border-accent/30 px-2 py-1 font-display text-[10px] tracking-widest text-accent uppercase">
              {item.level}
            </span>
            <h2 class="mt-6 font-display text-xl font-bold tracking-tight">{item.title}</h2>
            <p class="mt-4 flex-1 text-sm leading-relaxed text-muted-foreground">{item.summary}</p>
            {item.requirements.length > 0 && (
              <div class="mt-6 border-t border-border pt-5">
                <div class="font-display text-[10px] tracking-widest text-muted uppercase">
                  We require
                </div>
                <ul class="mt-3 space-y-2">
                  {item.requirements.map((req) => (
                    <li class="flex gap-3 text-sm text-muted-foreground">
                      <span class="text-accent">—</span>
                      {req}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))
      }
    </ul>

    <p
      class="mt-14 border border-border p-10 text-center text-sm leading-relaxed text-muted-foreground"
    >
      Have your own idea? Write to <a
        href={`mailto:${site.email}`}
        class="font-display text-xs tracking-widest text-accent uppercase">{site.email}</a
      > with a short CV, a research statement, and a contact reference.
    </p>
  </div>
</Base>
