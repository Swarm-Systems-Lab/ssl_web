---
import Page from "@/layouts/Page.astro";
import Picture from "@/components/Picture.astro";
import Text from "@/components/Text.astro";
import ApplyBox from "@/components/ApplyBox.astro";
import { studentProjects } from "@/lib/data";
import { optionalPicture } from "@/lib/images";
import { url } from "@/lib/url";
/**
 * How many pictures are on screen before any scrolling. Those are fetched
 * straight away; everything further down stays lazy, which is the default.
 */
const ABOVE_THE_FOLD = 2;
---

<Page name="student-projects">
  <div class="mx-auto max-w-7xl px-6 pb-16">
    <a
      href={url("/join-us")}
      class="mb-10 inline-block font-display text-[10px] tracking-widest text-accent uppercase"
    >
      ← Join us
    </a>

    <ul class="grid gap-px md:grid-cols-2">
      {
        studentProjects.items.map((item, index) => {
          const photo = optionalPicture(item.image);
          return (
            <li class="flex flex-col border border-border bg-surface/30 transition-colors hover:border-accent/50">
              {photo && (
                <Picture
                  src={photo}
                  alt={item.imageAlt ?? item.title}
                  widths={[960]}
                  sizes="(min-width: 768px) 50vw, 100vw"
                  loading={index < ABOVE_THE_FOLD ? "eager" : "lazy"}
                  zoom
                  class="aspect-[21/9] w-full border-b border-border object-cover"
                />
              )}
              <div class="flex flex-1 flex-col p-8">
                <span class="self-start border border-accent/30 px-2 py-1 font-display text-[10px] tracking-widest text-accent uppercase">
                  {item.level}
                </span>
                <h2 class="mt-6 font-display text-xl font-bold tracking-tight">{item.title}</h2>
                <Text
                  text={item.summary}
                  class="mt-4 flex-1 text-sm leading-relaxed text-muted-foreground"
                />
                {item.requirements.length > 0 && (
                  <div class="mt-6 border-t border-border pt-5">
                    <div class="font-display text-[10px] tracking-widest text-muted uppercase">
                      We require
                    </div>
                    <ul class="mt-3 space-y-2">
                      {item.requirements.map((req) => (
                        <li class="flex gap-3 text-sm text-muted-foreground">
                          <span class="text-accent">—</span>
                          <Text text={req} as="span" />
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </li>
          );
        })
      }
    </ul>

    <ApplyBox class="mt-16" />
  </div>
</Page>
