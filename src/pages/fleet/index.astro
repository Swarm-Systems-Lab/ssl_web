---
import Page from "@/layouts/Page.astro";
import { pageText, label } from "@/lib/data";
import Rule from "@/components/Rule.astro";
import Picture from "@/components/Picture.astro";
import Text from "@/components/Text.astro";
import { getFleet, FLEET_GROUPS } from "@/lib/collections";
import { url } from "@/lib/url";

const robots = await getFleet();
const groups = FLEET_GROUPS.map((group) => ({
  ...group,
  robots: robots.filter((robot) => robot.group === group.key),
})).filter((group) => group.robots.length > 0);

// How many machines come before each block, so "the first few on the page" is
// counted down the whole page rather than restarting at every heading.
let seen = 0;
const shown = groups.map((group) => {
  const before = seen;
  seen += group.robots.length;
  return { ...group, before };
});

/** The whole card is the click target - see the team page for the why. */
const STRETCH = "after:absolute after:inset-0 after:content-['']";

/** Pictures on screen before any scrolling are fetched straight away. */
const ABOVE_THE_FOLD = 3;
const text = pageText("fleet");
---

<Page name="fleet">
  <div class="mx-auto max-w-7xl px-6 pb-16">
    {
      shown.map((group) => (
        <section class="mb-16">
          <Rule label={group.label} />

          {group.key === "retired" ? (
            /* Retired machines read as a list, the way alumni do. */
            <ul class="grid gap-px md:grid-cols-2">
              {group.robots.map(({ entry, slug, hasPage, photo }, index) => (
                <li class="relative flex items-start gap-5 border border-border bg-surface/30 p-6 transition-colors hover:border-accent/50">
                  <div class="min-w-0 flex-1">
                    <div class="font-display text-sm font-bold">
                      {hasPage ? (
                        <a
                          href={url(`/fleet/${slug}`)}
                          class:list={["transition-colors hover:text-accent", STRETCH]}
                        >
                          {entry.data.name}
                        </a>
                      ) : (
                        entry.data.name
                      )}
                    </div>
                    <p class="mt-2 text-sm text-muted-foreground">{entry.data.summary}</p>
                    {entry.data.note && (
                      <p class="mt-2 font-display text-[10px] tracking-widest text-muted uppercase">
                        {entry.data.note}
                      </p>
                    )}
                  </div>

                  {photo && (
                    <Picture
                      src={photo}
                      alt={entry.data.name}
                      widths={[160]}
                      sizes="80px"
                      loading={group.before + index < ABOVE_THE_FOLD ? "eager" : "lazy"}
                      class="size-20 shrink-0 border border-border object-cover"
                    />
                  )}
                </li>
              ))}
            </ul>
          ) : (
            <ul class="grid gap-px sm:grid-cols-2 lg:grid-cols-3">
              {group.robots.map(({ entry, slug, hasPage, photo }, index) => (
                <li class="relative flex flex-col border border-border bg-surface/30 transition-colors hover:border-accent/50">
                  {photo && (
                    <Picture
                      src={photo}
                      alt={entry.data.name}
                      widths={[960]}
                      sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
                      loading={group.before + index < ABOVE_THE_FOLD ? "eager" : "lazy"}
                      class="aspect-[4/3] w-full border-b border-border object-cover"
                    />
                  )}
                  <div class="flex flex-1 flex-col p-6">
                    <div class="font-display text-[10px] tracking-widest text-accent uppercase">
                      {entry.data.role}
                    </div>

                    <h3 class="mt-2 flex items-baseline gap-2 font-display text-lg font-bold tracking-tight">
                      {hasPage ? (
                        <a
                          href={url(`/fleet/${slug}`)}
                          class:list={["transition-colors hover:text-accent", STRETCH]}
                        >
                          {entry.data.name}
                        </a>
                      ) : (
                        entry.data.name
                      )}
                      {entry.data.count && (
                        <span class="font-display text-sm font-normal text-muted">
                          &times;{entry.data.count}
                        </span>
                      )}
                    </h3>

                    <p class="mt-3 flex-1 text-sm leading-relaxed text-muted-foreground">
                      {entry.data.summary}
                    </p>

                    {entry.data.specs.length > 0 && (
                      <dl class="mt-5 border-t border-border pt-4 text-sm">
                        {entry.data.specs.map((spec) => (
                          <div class="flex justify-between gap-4 py-1">
                            <dt class="font-display text-[10px] tracking-widest text-muted uppercase">
                              {spec.label}
                            </dt>
                            <dd class="text-right text-muted-foreground">
                              {/* Only the links are lifted, not the whole row:
                                  the card's stretched overlay still takes a
                                  click on the spec itself, so the card as a
                                  whole keeps working as one target. */}
                              <Text as="span" text={spec.value} class="[&_a]:relative" />
                            </dd>
                          </div>
                        ))}
                      </dl>
                    )}

                    {entry.data.links.length > 0 && (
                      /* Accent, the way a paper's DOI and PDF links are: muted
                         would be the same 10px uppercase as a spec label right
                         above it, and "Design" would read as a spec with no
                         value rather than as somewhere to click.
                         `relative` lifts these above the stretched overlay. */
                      <div class="relative mt-5 flex flex-wrap gap-4 font-display text-[10px] tracking-widest uppercase">
                        {entry.data.links.map((l) => (
                          <a href={l.href} rel="noopener" class="text-accent">
                            {l.label}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }

    {
      robots.length === 0 && (
        <p class="border border-border bg-surface/30 p-8 text-sm text-muted-foreground">
          {label(text, "empty", "fleet")}
        </p>
      )
    }
  </div>
</Page>
