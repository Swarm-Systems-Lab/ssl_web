---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import { getNews, formatDate } from "@/lib/collections";
import { url } from "@/lib/url";

const news = await getNews();
---

<Base
  title="News"
  description="Announcements, papers, visits, and field tests from the Swarm Systems Lab."
>
  <PageHeader
    eyebrow="News"
    title="LAB"
    accent="NEWS."
    description="Papers, visits, field tests, and everything else happening in the lab."
  />

  <section class="mx-auto max-w-4xl px-6 pb-16">
    <ol class="border-t border-border">
      {
        news.map((item) => (
          <li class="border-b border-border py-9">
            <div class="mb-3 flex items-center gap-3 font-display text-[10px] tracking-widest">
              <time datetime={item.data.date.toISOString()} class="text-accent">
                {formatDate(item.data.date)}
              </time>
              {item.data.tags.map((tag) => (
                <span class="text-muted uppercase">#{tag}</span>
              ))}
            </div>
            <h2 class="font-display text-xl leading-snug font-bold tracking-tight">
              <a href={url(`/news/${item.id}`)} class="transition-colors hover:text-accent">
                {item.data.title}
              </a>
            </h2>
            <p class="mt-3 leading-relaxed text-muted-foreground">{item.data.summary}</p>
          </li>
        ))
      }
    </ol>
    {news.length === 0 && <p class="text-muted-foreground">No news posts yet.</p>}
  </section>
</Base>
