---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import Picture from "@/components/Picture.astro";
import Rule from "@/components/Rule.astro";
import PressShelf from "@/components/PressShelf.astro";
import ShowMore from "@/components/ShowMore.astro";
import { press } from "@/lib/data";
import { getNews, newsSummary, newsMedia, formatDate } from "@/lib/collections";
import { url } from "@/lib/url";

const news = (await getNews()).map((entry) => ({
  entry,
  summary: newsSummary(entry),
  // Falls back to the first picture in the post's folder.
  thumbnail: newsMedia(entry).header,
}));
/**
 * How many posts the page opens with. The rest are in the page too - every
 * post is in the HTML, so a search engine and a reader without JavaScript get
 * the lot - and the script folds them away behind a button.
 */
const AT_FIRST = 10;
/**
 * How many pictures are on screen before any scrolling. Those are fetched
 * straight away; everything further down stays lazy, which is the default.
 */
const ABOVE_THE_FOLD = 2;
---

<Base
  title="News"
  description="Announcements, papers, visits, and field tests from the Swarm Systems Lab."
>
  <PageHeader
    page="news"
    eyebrow="News"
    title="LAB NEWS."
    accent="NEWS."
    description="Papers, visits, field tests, and everything else happening in the lab."
  />

  {
    press.items.length > 0 && (
      <section class="mx-auto max-w-7xl px-6 pb-14">
        <Rule label="In the press" />
        <PressShelf />
      </section>
    )
  }

  <section class="mx-auto max-w-7xl px-6 pb-16" data-collapsible>
    <ol class="border-t border-border">
      {
        news.map(({ entry, summary, thumbnail }, index) => (
          <li
            class="grid gap-8 border-b border-border py-9 sm:grid-cols-[minmax(0,1fr)_20rem]"
            data-entry
          >
            <div>
              <div class="mb-3 flex items-center gap-3 font-display text-[10px] tracking-widest">
                <time datetime={entry.data.date.toISOString()} class="text-accent">
                  {formatDate(entry.data.date)}
                </time>
                {entry.data.tags.map((tag) => (
                  <span class="text-muted uppercase">#{tag}</span>
                ))}
              </div>
              <h2 class="font-display text-xl leading-snug font-bold tracking-tight">
                <a href={url(`/news/${entry.id}`)} class="transition-colors hover:text-accent">
                  {entry.data.title}
                </a>
              </h2>
              {summary && <p class="mt-3 leading-relaxed text-muted-foreground">{summary}</p>}
            </div>

            {thumbnail && (
              <a href={url(`/news/${entry.id}`)} class="block">
                <Picture
                  src={thumbnail}
                  alt={entry.data.imageAlt ?? entry.data.title}
                  widths={[320, 640]}
                  sizes="(min-width: 640px) 320px, 100vw"
                  still
                  loading={index < ABOVE_THE_FOLD ? "eager" : "lazy"}
                  class="aspect-[4/3] w-full border border-border object-cover transition-colors hover:border-accent/50"
                />
              </a>
            )}
          </li>
        ))
      }
    </ol>

    {news.length > 0 && <ShowMore limit={AT_FIRST} total={news.length} noun="posts" />}

    {news.length === 0 && <p class="text-muted-foreground">No news posts yet.</p>}
  </section>
</Base>
