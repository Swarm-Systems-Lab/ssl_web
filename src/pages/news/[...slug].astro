---
import { render } from "astro:content";
import Base from "@/layouts/Base.astro";
import Picture from "@/components/Picture.astro";
import Carousel from "@/components/Carousel.astro";
import Rule from "@/components/Rule.astro";
import PublicationEntry from "@/components/PublicationEntry.astro";
import { getNews, newsSummary, newsMedia, worksByRef, formatDate } from "@/lib/collections";
import { socialImage } from "@/lib/social-image";
import { url } from "@/lib/url";

export async function getStaticPaths() {
  const news = await getNews();
  return news.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// The header picture, plus every other picture in the post's folder as a
// carousel. `image:` and `gallery:` in the frontmatter override both.
const { header, slides } = newsMedia(entry);
// Still worth generating for the link preview, where a page needs to say
// something about itself even when the post does not spell it out.
const summary = newsSummary(entry);
// Papers are named by reference, so a post never restates what
// publications.yaml already holds.
const works = worksByRef(entry.data.works, `content/news/${entry.id}/index.md`);
---

<Base
  title={entry.data.title}
  description={summary || entry.data.title}
  image={await socialImage(header)}
>
  <article class="mx-auto max-w-3xl px-6 pt-20 pb-16">
    <a href={url("/news")} class="font-display text-[10px] tracking-widest text-accent uppercase">
      ← All news
    </a>

    <header class="mt-10 border-b border-border pb-10">
      <div class="mb-4 flex items-center gap-3 font-display text-[10px] tracking-widest">
        <time datetime={entry.data.date.toISOString()} class="text-accent">
          {formatDate(entry.data.date)}
        </time>
        {entry.data.tags.map((tag) => <span class="text-muted uppercase">#{tag}</span>)}
      </div>
      <h1 class="font-display text-3xl leading-tight font-bold tracking-tighter md:text-4xl">
        {entry.data.title}
      </h1>
      {
        /* Only a summary written by hand earns a place here: the automatic one
          is drawn from the text printed directly below it. */
      }
      {
        entry.data.summary && (
          <p class="mt-5 text-lg leading-relaxed text-muted-foreground">{entry.data.summary}</p>
        )
      }
    </header>

    {
      header && (
        <Picture
          src={header}
          alt={entry.data.imageAlt ?? entry.data.title}
          widths={[640, 960, 1280]}
          sizes="(min-width: 768px) 768px, 100vw"
          priority
          zoom
          class="mt-10 w-full border border-border"
        />
      )
    }

    <div class="prose-lab mt-10"><Content /></div>

    {
      slides.length > 0 && (
        <Carousel
          slides={slides}
          label={`Pictures from ${entry.data.title}`}
          class="mt-12"
          sizes="(min-width: 768px) 768px, 100vw"
        />
      )
    }
    {
      works.length > 0 && (
        <section class="mt-14">
          <Rule label={works.length === 1 ? "The paper" : "The papers"} />
          <ol class="space-y-8">
            {works.map((pub) => (
              <PublicationEntry pub={pub} />
            ))}
          </ol>
        </section>
      )
    }
  </article>
</Base>
