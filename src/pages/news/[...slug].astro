---
import { render } from "astro:content";
import Base from "@/layouts/Base.astro";
import Picture from "@/components/Picture.astro";
import Carousel from "@/components/Carousel.astro";
import { getNews, newsSummary, newsPictures, formatDate } from "@/lib/collections";
import { pictureUrl } from "@/lib/images";
import { url } from "@/lib/url";

export async function getStaticPaths() {
  const news = await getNews();
  return news.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// The header picture, plus every other picture in the post's folder as a
// carousel. `image:` and `gallery:` in the frontmatter override both.
const { header, slides } = newsPictures(entry);
const summary = newsSummary(entry);
---

<Base title={entry.data.title} description={summary} image={header && pictureUrl(header)}>
  <article class="mx-auto max-w-3xl px-6 pt-20 pb-16">
    <a href={url("/news")} class="font-display text-[10px] tracking-widest text-accent uppercase">
      ← All news
    </a>

    <header class="mt-10 border-b border-border pb-10">
      <div class="mb-4 flex items-center gap-3 font-display text-[10px] tracking-widest">
        <time datetime={entry.data.date.toISOString()} class="text-accent">
          {formatDate(entry.data.date)}
        </time>
        {entry.data.tags.map((tag) => <span class="text-muted uppercase">#{tag}</span>)}
      </div>
      <h1 class="font-display text-3xl leading-tight font-bold tracking-tighter md:text-4xl">
        {entry.data.title}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-muted-foreground">{summary}</p>
    </header>

    {
      header && (
        <Picture
          src={header}
          alt={entry.data.imageAlt ?? entry.data.title}
          widths={[640, 960, 1280]}
          sizes="(min-width: 768px) 768px, 100vw"
          loading="eager"
          class="mt-10 w-full border border-border"
        />
      )
    }

    <div class="prose-lab mt-10"><Content /></div>

    {
      slides.length > 0 && (
        <Carousel
          slides={slides}
          label={`Pictures from ${entry.data.title}`}
          class="mt-12"
          sizes="(min-width: 768px) 768px, 100vw"
        />
      )
    }
  </article>
</Base>
