---
import { getEntry, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import Rule from "@/components/Rule.astro";
import Picture from "@/components/Picture.astro";
import { getNews, newsPictures, getResearch, formatDate } from "@/lib/collections";
import { site } from "@/lib/data";
import { coverFor } from "@/lib/covers";
import { gallery } from "@/lib/media";
import { url } from "@/lib/url";

const home = await getEntry("pages", "home");
const { Content } = home ? await render(home) : { Content: null };

const news = (await getNews())
  .slice(0, 4)
  .map((entry) => ({ entry, thumbnail: newsPictures(entry).header }));
const research = (await getResearch()).slice(0, 3);

// content/covers/home.*, falling back to the newest photo in the gallery.
const cover = coverFor("home") ?? gallery.find((item) => item.kind === "photo");
---

<Base>
  <section class="mx-auto max-w-7xl px-6 pt-20 pb-12">
    <div
      class="mb-4 flex items-center gap-3 font-display text-xs tracking-widest text-accent uppercase"
    >
      <span class="size-1.5 rounded-full bg-accent"></span>{site.institution}
    </div>
    <h1
      class="font-display text-4xl leading-[0.92] font-bold tracking-tighter text-balance md:text-6xl"
    >
      SWARM SYSTEMS <span class="text-muted">LAB.</span>
    </h1>
    {
      Content && (
        <div class="prose-lab mt-8">
          <Content />
        </div>
      )
    }

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={url("/research")}
        class="bg-accent px-4 py-3 font-display text-xs tracking-widest text-accent-foreground uppercase transition-opacity hover:opacity-90"
      >
        Our research →
      </a>
      <a
        href={url("/join-us")}
        class="border border-border px-4 py-3 font-display text-xs tracking-widest uppercase transition-colors hover:border-accent/50 hover:text-accent"
      >
        Join us
      </a>
    </div>
  </section>

  {
    cover && (
      <section class="mx-auto max-w-7xl px-6 pb-20">
        <figure class="border border-border bg-surface">
          {/* Shown whole rather than cropped — the team photo is the point. */}
          <Picture
            src={cover.src}
            alt={cover.caption ?? `The ${site.title} team`}
            widths={[720, 1080, 1440, 1920]}
            sizes="(min-width: 1280px) 1216px, 100vw"
            loading="eager"
            class="h-auto w-full"
          />
          {cover.caption && (
            <figcaption class="border-t border-border p-4 font-display text-[10px] tracking-widest text-muted uppercase">
              {cover.caption}
            </figcaption>
          )}
        </figure>
      </section>
    )
  }

  {
    site.community.length > 0 && (
      <section class="border-y border-border bg-surface/30 py-16">
        <div class="mx-auto max-w-7xl px-6">
          <Rule label="Find us elsewhere" />
          <ul class="grid gap-px md:grid-cols-3">
            {site.community.map((item) => (
              <li class="group border border-border bg-background p-8 transition-colors hover:border-accent/50">
                <a href={item.href} rel="noopener" class="block">
                  <h3 class="font-display text-2xl font-bold tracking-tight transition-colors group-hover:text-accent">
                    {item.label}
                  </h3>
                  <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
                    {item.description}
                  </p>
                  <span class="mt-6 inline-block font-display text-[10px] tracking-widest text-accent uppercase">
                    Open {item.label} →
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    research.length > 0 && (
      <section class="mx-auto max-w-7xl px-6 py-16">
        <Rule label="Research" />
        <ul class="grid gap-px md:grid-cols-3">
          {research.map((topic) => (
            <li class="flex flex-col border border-border bg-surface/30 transition-colors hover:border-accent/50">
              {topic.data.image && (
                <Picture
                  src={topic.data.image}
                  alt={topic.data.imageAlt ?? topic.data.title}
                  widths={[400, 800]}
                  sizes="(min-width: 768px) 400px, 100vw"
                  class="aspect-video w-full border-b border-border object-cover"
                />
              )}
              <div class="p-6">
                <h3 class="font-display text-sm font-bold">
                  <a
                    href={url(`/research/${topic.id}`)}
                    class="transition-colors hover:text-accent"
                  >
                    {topic.data.title}
                  </a>
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                  {topic.data.summary}
                </p>
              </div>
            </li>
          ))}
        </ul>
        <a
          href={url("/research")}
          class="mt-8 inline-block font-display text-[11px] tracking-widest text-accent uppercase"
        >
          All research topics →
        </a>
      </section>
    )
  }

  {
    news.length > 0 && (
      <section class="mx-auto max-w-7xl px-6 pb-20">
        <div class="grid gap-12 lg:grid-cols-12">
          <div class="lg:col-span-4">
            <Rule label="Latest news" />
            <p class="max-w-sm text-sm leading-relaxed text-muted-foreground">
              Papers, visits, field tests, and milestones from the lab.
            </p>
            <a
              href={url("/news")}
              class="mt-6 inline-block border-b border-accent/30 pb-1 font-display text-xs tracking-widest text-accent uppercase hover:border-accent"
            >
              Read all news →
            </a>
          </div>

          <ol class="lg:col-span-8">
            {news.map(({ entry, thumbnail }) => (
              <li class="flex items-start gap-5 border-b border-border py-5 last:border-0">
                <div class="flex-1">
                  <time
                    datetime={entry.data.date.toISOString()}
                    class="font-display text-[10px] tracking-widest text-muted"
                  >
                    {formatDate(entry.data.date)}
                  </time>
                  <a
                    href={url(`/news/${entry.id}`)}
                    class="mt-1 block transition-colors hover:text-accent"
                  >
                    {entry.data.title}
                  </a>
                </div>
                {thumbnail && (
                  <a href={url(`/news/${entry.id}`)} class="shrink-0">
                    <Picture
                      src={thumbnail}
                      alt={entry.data.imageAlt ?? entry.data.title}
                      widths={[160, 320]}
                      sizes="96px"
                      class="size-24 border border-border object-cover"
                    />
                  </a>
                )}
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }
</Base>
