---
import { Image } from "astro:assets";
import { IMAGE_QUALITY, type Media } from "@/lib/images";
import { fullSize } from "@/lib/full-size";
import { displayFor, objectPosition } from "@/lib/display";
import { youtubeId } from "@/lib/video";
import { youtubeStill } from "@/lib/poster";
import YouTube from "@/components/YouTube.astro";

interface Props {
  src: Media;
  alt: string;
  widths?: number[];
  sizes?: string;
  loading?: "lazy" | "eager";
  /**
   * The one picture a page is judged on: usually its cover or the header of a
   * post. Fetched eagerly, ahead of everything else, and decoded on the spot.
   * At most one per page - marking several is the same as marking none.
   */
  priority?: boolean;
  /**
   * Let a click open the picture full size, in the lightbox the layout
   * carries. For pictures that are not already inside a link - where a click
   * belongs to the link, not to the picture.
   */
  zoom?: boolean;
  /**
   * Show a video as its own still rather than as something to play: what a
   * listing thumbnail wants, where the click belongs to the entry around it.
   */
  still?: boolean;
  /**
   * Which part of the picture to keep when the frame crops it, as a keyword
   * like "top" or percentages like "50% 20%". Normally left out: a picture
   * that always wants the same framing says so in its folder's images.yaml,
   * which this overrides for one place on the site.
   */
  focus?: string;
  class?: string;
}

const {
  src,
  alt,
  widths,
  sizes,
  loading = "lazy",
  priority = false,
  zoom = false,
  still = false,
  focus,
  class: className,
} = Astro.props;

// A YouTube video travels as "youtube:<id>". Asked for as a still it becomes
// its poster frame, and everything below treats it as the picture it now is;
// only a video that is meant to be played renders a player.
const video = youtubeId(src);
const play = video && !still ? video : undefined;
const source: Media = video ? await youtubeStill(video) : src;

// What the picture's own folder says about it. Cropping only happens with
// object-cover, so the focus is inert everywhere else.
const settings = displayFor(video ? src : source);
const position = objectPosition(focus ?? settings?.focus);

/*
 * Zooming means painting the picture at a size other than its own box, which
 * needs something to clip it and a box with a height to clip against. Where
 * the frame has no height of its own the picture is being shown whole already,
 * nothing is cropped, and a zoom would only collapse the layout - so it is
 * ignored rather than obeyed.
 *
 * Above 1 the picture fills the frame and is cropped closer; below 1 it is
 * fitted whole and stands away from the edges.
 */
const FRAMED = /(^|\s)(aspect-|size-|min-h-|h-(?!auto\b))/;
const zoomTo = settings?.zoom && settings.zoom !== 1 ? settings.zoom : undefined;
const magnified = zoomTo && FRAMED.test(className ?? "") ? zoomTo : undefined;
const shrunk = magnified !== undefined && magnified < 1;

const style = [
  position && `object-position: ${position}`,
  // Anchored on the same point the crop is, so zooming keeps it in view.
  magnified && `transform: scale(${magnified}); transform-origin: ${position ?? "center"}`,
]
  .filter(Boolean)
  .join("; ");
// Alt written next to the picture describes the picture itself, which beats
// whatever the page around it happened to call it.
const description = settings?.alt ?? alt;

/*
 * The frame that does the clipping. Only a zoomed picture needs one, so
 * everywhere else it is `display: contents` - it generates no box at all and
 * the picture stays exactly the element its container was laid out around.
 */
const frame = magnified ? ["block overflow-hidden", shrunk && "bg-mat", className] : "contents";
const paint = magnified ? ["h-full w-full", shrunk ? "object-contain" : "object-cover"] : className;
const isVideo = typeof source === "string" && /\.(mp4|webm)$/.test(source);

// Astro emits the fallback `src` at the picture's own resolution unless it is
// told otherwise, which for a 6 MB photo means shipping a 2 MB variant nobody
// asks for. Cap it at the largest width the caller actually uses.
const width = widths?.length ? Math.max(...widths) : undefined;

// `priority` sets loading, decoding, and fetchpriority together, so passing
// `loading` alongside it would only fight with it.
const speed = priority ? { priority: true } : { loading };

// The lightbox finds a picture by this attribute alone. The role and tabindex
// put it in the tab order, which a bare <img> never is.
const full = zoom && !isVideo && !video ? await fullSize(source) : undefined;
const zoomAttrs = {
  "data-zoom": full,
  role: full ? ("button" as const) : undefined,
  tabindex: full ? 0 : undefined,
  "aria-label": full
    ? description
      ? `${description} - view full size`
      : "View full size"
    : undefined,
};
---

{
  play ? (
    /* A video meant to be played; asked for as a still it falls through to the
       branches below, as its poster frame. */
    <YouTube id={play} label={description} loading={loading} class:list={className} />
  ) : isVideo ? (
    <video
      src={source as string}
      muted
      loop
      playsinline
      controls
      preload="none"
      class={className}
    />
  ) : (
    <span class:list={frame}>
      {typeof source === "string" ? (
        /* GIFs and vectors are served untouched, so this is a plain <img>:
           there is no format to convert to and no size to resize to. */
        <img
          src={source}
          alt={description}
          style={style || undefined}
          loading={priority ? "eager" : loading}
          decoding={priority ? "sync" : "async"}
          fetchpriority={priority ? "high" : undefined}
          class:list={[paint, full && "cursor-zoom-in"]}
          {...zoomAttrs}
        />
      ) : (
        <Image
          src={source}
          alt={description}
          style={style || undefined}
          widths={widths}
          width={width}
          sizes={sizes}
          quality={IMAGE_QUALITY}
          class:list={[paint, full && "cursor-zoom-in"]}
          {...speed}
          {...zoomAttrs}
        />
      )}
    </span>
  )
}
