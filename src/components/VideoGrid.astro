---
import YouTube from "@/components/YouTube.astro";

/**
 * A row of YouTube videos, used on the front page and on the media page.
 *
 * Nothing is embedded until someone asks to watch. Each video shows its own
 * thumbnail with a play button, and the player is inserted on the first click.
 * A YouTube embed costs about half a megabyte and a good deal of main-thread
 * work before it can show a single frame, so three of them on one page is the
 * difference between a page that opens instantly and one that does not.
 */

export interface Video {
  youtube: string;
  title: string;
  date?: string;
}

interface Props {
  videos: Video[];
  columns?: string;
  /** How many players start on screen, and so load their thumbnail eagerly. */
  aboveTheFold?: number;
  class?: string;
}

const {
  videos,
  columns = "md:grid-cols-2 lg:grid-cols-3",
  aboveTheFold = 0,
  class: className,
} = Astro.props;
---

<ul class:list={["grid gap-px", columns, className]}>
  {
    videos.map((video, index) => (
      <li class="border border-border bg-surface/30 transition-colors hover:border-accent/50">
        <div class="aspect-video border-b border-border">
          <YouTube
            id={video.youtube}
            label={video.title}
            loading={index < aboveTheFold ? "eager" : "lazy"}
            class="h-full w-full"
          />
        </div>
        <div class="p-5">
          {video.date && (
            <div class="font-display text-[10px] tracking-widest text-muted">{video.date}</div>
          )}
          <h3 class="mt-2 font-display text-sm font-bold">{video.title}</h3>
        </div>
      </li>
    ))
  }
</ul>
