---
import Picture from "@/components/Picture.astro";
import { youtubeRef } from "@/lib/video";
import type { Media } from "@/lib/images";

/**
 * A row of videos, used on the front page and on the media page. They can be
 * ours or YouTube's - `Picture` knows the difference and draws each one the
 * way it should be drawn, so this only has to lay them out.
 *
 * Nothing is fetched until someone asks to watch: a YouTube video shows its
 * still until the play button is pressed, and a clip of ours shows the frame
 * it opens on. A YouTube embed costs about half a megabyte before it can paint
 * anything, so three of them on one page is the difference between a page that
 * opens instantly and one that does not.
 */

export interface Video {
  /** A YouTube id or link, for a video that lives there. */
  youtube?: string;
  /** Or one of ours, already resolved. */
  src?: Media;
  title: string;
  date?: string;
}

interface Props {
  videos: Video[];
  columns?: string;
  /** How many players start on screen, and so load their thumbnail eagerly. */
  aboveTheFold?: number;
  class?: string;
}

const {
  videos,
  columns = "md:grid-cols-2 lg:grid-cols-3",
  aboveTheFold = 0,
  class: className,
} = Astro.props;
---

<ul class:list={["grid gap-px", columns, className]}>
  {
    videos.map((video, index) => (
      <li class="border border-border bg-surface/30 transition-colors hover:border-accent/50">
        <div class="aspect-video border-b border-border bg-mat">
          <Picture
            src={video.src ?? youtubeRef(video.youtube ?? "")}
            alt={video.title}
            loading={index < aboveTheFold ? "eager" : "lazy"}
            class="h-full w-full object-cover"
          />
        </div>
        <div class="p-5">
          {video.date && (
            <div class="font-display text-[10px] tracking-widest text-muted">{video.date}</div>
          )}
          <h3 class="mt-2 font-display text-sm font-bold">{video.title}</h3>
        </div>
      </li>
    ))
  }
</ul>
