---
import Picture from "@/components/Picture.astro";
import Slider from "@/components/Slider.astro";
import { displayFor } from "@/lib/display";
import type { Media } from "@/lib/images";

/**
 * Horizontal picture carousel used wherever several pictures belong together:
 * a news post with a gallery, the Granada photos on the Join us page, and so
 * on. One picture fills the frame at a time.
 *
 * A single slide degrades to a plain figure, so callers never have to check
 * how many pictures they have.
 */

export interface Slide {
  src: Media;
  alt: string;
  caption?: string;
}

interface Props {
  slides: Slide[];
  /** Describes the set for screen readers, e.g. "Photos of Granada". */
  label: string;
  /** Tailwind aspect class applied to each slide. */
  aspect?: string;
  sizes?: string;
  widths?: number[];
  loading?: "lazy" | "eager";
  /** Marks the first slide as the page's priority picture. */
  priority?: boolean;
  /**
   * Show artwork rather than photographs: each picture is fitted whole onto a
   * white ground instead of being cropped to fill a dark one. A logo with
   * see-through parts is invisible without it.
   */
  plate?: boolean;
  class?: string;
}

const {
  slides,
  label,
  aspect = "aspect-[16/9]",
  sizes = "(min-width: 1024px) 900px, 100vw",
  widths = [640, 960, 1440],
  loading = "lazy",
  priority = false,
  plate = false,
  class: className,
} = Astro.props;

const single = slides.length === 1;

// A caption written in the picture's own folder stands in wherever the caller
// has none of its own - the awards and the Granada photos are listed in YAML,
// which carries no captions, so this is the only way they can have one.
const shown = slides.map((slide) => ({
  ...slide,
  caption: slide.caption ?? displayFor(slide.src)?.caption,
}));
---

{
  slides.length > 0 && (
    <Slider
      label={label}
      count={shown.length}
      dots
      interactive={!single}
      class:list={["border border-border bg-surface/30", className]}
    >
      {shown.map((slide, index) => (
        <figure class="w-full shrink-0 snap-start">
          <div class:list={["overflow-hidden", aspect, plate ? "bg-white" : "bg-mat"]}>
            <Picture
              src={slide.src}
              alt={slide.alt}
              widths={widths}
              sizes={sizes}
              loading={index === 0 ? loading : "lazy"}
              priority={index === 0 && priority}
              zoom
              class:list={["h-full w-full", plate ? "object-contain p-3" : "object-cover"]}
            />
          </div>
          {slide.caption && (
            <figcaption class="border-t border-border p-4 text-sm text-muted-foreground">
              {slide.caption}
            </figcaption>
          )}
        </figure>
      ))}
    </Slider>
  )
}
