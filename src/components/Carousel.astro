---
import Picture from "@/components/Picture.astro";
import type { Picture as PictureSource } from "@/lib/images";

/**
 * Horizontal picture carousel used wherever several pictures belong together:
 * a news post with a gallery, the Granada photos on the Join us page, and so on.
 *
 * It is a scroll-snapping strip first and a carousel second - with no
 * JavaScript it still swipes and scrolls; the script only adds the arrows and
 * the dots. A single slide renders as a plain figure, so callers never have to
 * check how many pictures they have.
 */

export interface Slide {
  src: PictureSource;
  alt: string;
  caption?: string;
}

interface Props {
  slides: Slide[];
  /** Describes the set for screen readers, e.g. "Photos of Granada". */
  label: string;
  /** Tailwind aspect class applied to each slide. */
  aspect?: string;
  sizes?: string;
  widths?: number[];
  loading?: "lazy" | "eager";
  /** Marks the first slide as the page's priority picture. */
  priority?: boolean;
  /**
   * Show artwork rather than photographs: each picture is fitted whole onto a
   * white ground instead of being cropped to fill a dark one. A logo with
   * see-through parts is invisible without it.
   */
  plate?: boolean;
  class?: string;
}

const {
  slides,
  label,
  aspect = "aspect-[16/9]",
  sizes = "(min-width: 1024px) 900px, 100vw",
  widths = [640, 960, 1440],
  loading = "lazy",
  priority = false,
  plate = false,
  class: className,
} = Astro.props;

const single = slides.length === 1;
---

{
  slides.length > 0 && (
    <div
      class:list={["relative border border-border bg-surface/30", className]}
      data-carousel={single ? undefined : ""}
      role="group"
      aria-roledescription={single ? undefined : "carousel"}
      aria-label={label}
    >
      <div
        class:list={[
          "no-scrollbar flex snap-x snap-mandatory overflow-x-auto scroll-smooth",
          single && "overflow-x-hidden",
        ]}
        data-track
      >
        {slides.map((slide, index) => (
          <figure class="w-full shrink-0 snap-start">
            <div class:list={["overflow-hidden", aspect, plate ? "bg-white" : "bg-mat"]}>
              <Picture
                src={slide.src}
                alt={slide.alt}
                widths={widths}
                sizes={sizes}
                loading={index === 0 ? loading : "lazy"}
                priority={index === 0 && priority}
                zoom
                class:list={["h-full w-full", plate ? "object-contain p-3" : "object-cover"]}
              />
            </div>
            {slide.caption && (
              <figcaption class="border-t border-border p-4 text-sm text-muted-foreground">
                {slide.caption}
              </figcaption>
            )}
          </figure>
        ))}
      </div>

      {!single && (
        <Fragment>
          <button
            type="button"
            data-prev
            hidden
            aria-label="Previous picture"
            class="absolute top-1/2 left-2 grid size-9 -translate-y-1/2 place-items-center border border-border bg-background/80 font-display text-lg text-foreground backdrop-blur transition-colors hover:border-accent hover:text-accent disabled:opacity-30"
          >
            ‹
          </button>
          <button
            type="button"
            data-next
            hidden
            aria-label="Next picture"
            class="absolute top-1/2 right-2 grid size-9 -translate-y-1/2 place-items-center border border-border bg-background/80 font-display text-lg text-foreground backdrop-blur transition-colors hover:border-accent hover:text-accent disabled:opacity-30"
          >
            ›
          </button>

          <div
            class="pointer-events-none absolute inset-x-0 bottom-3 flex justify-center gap-1.5"
            data-dots
            hidden
          >
            {slides.map((_, index) => (
              <span
                class="size-1.5 rounded-full bg-foreground/30 transition-colors"
                data-dot={index}
              />
            ))}
          </div>
        </Fragment>
      )}
    </div>
  )
}

<script>
  // Progressive enhancement: the strip already scrolls and swipes on its own,
  // so everything here is additive.
  for (const root of document.querySelectorAll<HTMLElement>("[data-carousel]")) {
    const track = root.querySelector<HTMLElement>("[data-track]");
    const prev = root.querySelector<HTMLButtonElement>("[data-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-next]");
    const dots = [...root.querySelectorAll<HTMLElement>("[data-dot]")];
    if (!track || !prev || !next) continue;

    const count = track.children.length;
    const indexNow = () => Math.round(track.scrollLeft / track.clientWidth);
    const goTo = (index: number) =>
      track.scrollTo({ left: Math.max(0, Math.min(index, count - 1)) * track.clientWidth });

    const sync = () => {
      const index = indexNow();
      prev.disabled = index <= 0;
      next.disabled = index >= count - 1;
      dots.forEach((dot, position) => dot.classList.toggle("bg-accent", position === index));
    };

    prev.hidden = false;
    next.hidden = false;
    root.querySelector<HTMLElement>("[data-dots]")?.removeAttribute("hidden");

    prev.addEventListener("click", () => goTo(indexNow() - 1));
    next.addEventListener("click", () => goTo(indexNow() + 1));
    track.addEventListener("scroll", () => requestAnimationFrame(sync), { passive: true });
    window.addEventListener("resize", sync);
    sync();
  }
</script>
