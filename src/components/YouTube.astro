---
import { youtubeWatch } from "@/lib/video";
import { youtubeStill } from "@/lib/poster";

/**
 * A YouTube video, shown as its own still until someone asks to watch.
 *
 * The embed costs around half a megabyte and a good deal of main-thread work
 * before it can paint a single frame, so nothing is loaded from YouTube until
 * the play button is pressed. Until then it is a picture inside a plain link,
 * which is also what it stays without JavaScript.
 */

interface Props {
  /** The video id. */
  id: string;
  /** Describes the video, e.g. its title. */
  label: string;
  loading?: "lazy" | "eager";
  class?: string;
}

const { id, label, loading = "lazy", class: className } = Astro.props;

/*
 * A player is 16:9, so unless the caller has already given it a shape it takes
 * one. The still YouTube keeps is 4:3 with black bars down the top and bottom;
 * the frame crops them off.
 */
const FRAMED = /(^|\s)(aspect-|size-|h-(?!auto\b))/;
const shape = FRAMED.test(className ?? "") ? undefined : "aspect-video";

const still = await youtubeStill(id);
---

<a
  href={youtubeWatch(id)}
  rel="noopener"
  data-play={id}
  aria-label={`Play ${label}`}
  class:list={["group/play relative block bg-mat", shape, className]}
>
  <img
    src={still}
    alt=""
    width="1280"
    height="720"
    loading={loading}
    decoding="async"
    class="h-full w-full object-cover opacity-90 transition-opacity group-hover/play:opacity-100"
  />
  <span class="absolute inset-0 grid place-items-center">
    <span
      class="grid size-14 place-items-center rounded-full border border-white/40 bg-black/60 pl-1 text-xl text-white backdrop-blur transition-colors group-hover/play:border-accent group-hover/play:text-accent"
    >
      ▶
    </span>
  </span>
</a>

<script>
  import { youtubeEmbed } from "@/lib/video";

  // Swap the still for the real player on the first click. Until then the link
  // is a plain link to YouTube, which is what it falls back to.
  document.addEventListener("click", (event) => {
    const node = event.target;
    if (!(node instanceof Element)) return;
    const trigger = node.closest<HTMLElement>("[data-play]");
    const id = trigger?.dataset.play;
    if (!trigger || !id) return;

    event.preventDefault();
    const frame = document.createElement("iframe");
    frame.src = youtubeEmbed(id);
    frame.title = trigger.getAttribute("aria-label") ?? "";
    frame.allow = "accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture";
    frame.allowFullscreen = true;
    frame.className = "absolute inset-0 h-full w-full";
    trigger.replaceChildren(frame);
    trigger.removeAttribute("href");
  });
</script>
