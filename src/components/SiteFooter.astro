---
import { site } from "@/lib/data";
import Logo from "@/components/Logo.astro";
import { url } from "@/lib/url";
---

<footer class="mt-24 border-t border-border">
  <div class="mx-auto grid max-w-7xl gap-8 px-6 py-12 md:grid-cols-[2fr_1fr_1fr]">
    <div>
      <div class="font-display text-sm font-bold tracking-tighter">{site.title}</div>
      <p class="mt-3 max-w-sm text-sm text-muted-foreground">{site.institution}</p>
      <a
        href={`mailto:${site.email}`}
        class="mt-3 inline-block font-display text-xs tracking-wider text-accent">{site.email}</a
      >
    </div>

    <nav aria-label="Sections">
      <div class="font-display text-[10px] tracking-widest text-muted uppercase">Sections</div>
      <ul class="mt-4 space-y-2">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={url(item.href)}
                class="text-sm text-muted-foreground transition-colors hover:text-accent"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Elsewhere">
      <div class="font-display text-[10px] tracking-widest text-muted uppercase">Elsewhere</div>
      <ul class="mt-4 space-y-2">
        {
          site.social.map((item) => (
            <li>
              <a
                href={item.href}
                rel="noopener"
                class="flex items-center gap-2.5 text-sm text-muted-foreground transition-colors hover:text-accent"
              >
                <Logo
                  label={item.label}
                  name={item.logo}
                  white
                  size="h-4 w-4"
                  class="shrink-0 opacity-70"
                />
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="border-t border-border">
    <p class="mx-auto max-w-7xl px-6 py-5 font-display text-[10px] tracking-widest text-muted">
      © {new Date().getFullYear()}
      {site.title} - {site.institution}
    </p>
  </div>
</footer>
