---
import Picture from "@/components/Picture.astro";
import { optionalPicture } from "@/lib/images";
import { url } from "@/lib/url";
import type { Publication } from "@/lib/data";

/**
 * One paper, as it appears on the publications page: reference on the left,
 * the paper in the middle, its thumbnail on the right.
 *
 * A project page shows the same thing for the papers it lists, so a paper
 * reads identically wherever it is met.
 */

interface Props {
  pub: Publication;
  loading?: "lazy" | "eager";
}

const { pub, loading = "lazy" } = Astro.props;
const thumb = optionalPicture(pub.image);
---

<li class="flex gap-5" data-kind={pub.kind}>
  {/* The reference number always stays on the left. */}
  <span class="w-12 shrink-0 pt-1 font-display text-xs text-muted">[{pub.ref}]</span>

  <div class="min-w-0 flex-1">
    <h3 class="font-display text-base leading-snug font-medium">
      <a href={url(`/publications/${pub.slug}`)} class="transition-colors hover:text-accent">
        {pub.title}
      </a>
    </h3>
    <p class="mt-2 text-sm text-muted-foreground">
      {pub.authors} · <span class="text-foreground italic">{pub.venue}</span>
    </p>
    <div
      class="mt-3 flex flex-wrap items-center gap-4 font-display text-[10px] tracking-widest uppercase"
    >
      <span class="border border-border px-2 py-0.5 text-muted">{pub.kindLabel}</span>
      {
        pub.links.map((l) => (
          <a href={l.href} rel="noopener" class="text-accent">
            {l.label}
          </a>
        ))
      }
    </div>
    {
      pub.note && (
        <p class="mt-3 font-display text-[10px] tracking-widest text-accent uppercase">
          {pub.note}
        </p>
      )
    }
  </div>

  {
    thumb && (
      <a href={url(`/publications/${pub.slug}`)} class="shrink-0">
        <Picture
          src={thumb}
          alt={pub.imageAlt ?? pub.title}
          widths={[96, 192]}
          sizes="96px"
          loading={loading}
          class="size-24 border border-border object-cover transition-colors hover:border-accent/50"
        />
      </a>
    )
  }
</li>
