---
import { site } from "@/lib/data";
import { url, isActive } from "@/lib/url";

const here = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-border bg-background/85 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center gap-6 px-6 py-4">
    <a href={url("/")} class="font-display text-sm font-bold tracking-tighter whitespace-nowrap">
      {site.shortTitle}
    </a>

    <nav class="no-scrollbar ml-auto flex items-center gap-5 overflow-x-auto" aria-label="Main">
      {
        site.nav.map((item) => (
          <a
            href={url(item.href)}
            aria-current={isActive(here, item.href) ? "page" : undefined}
            class:list={[
              "font-display text-[11px] tracking-widest whitespace-nowrap uppercase transition-colors",
              isActive(here, item.href)
                ? "text-accent"
                : "text-muted-foreground hover:text-foreground",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
