---
import { site } from "@/lib/data";
import Logo from "@/components/Logo.astro";
import { url, isActive } from "@/lib/url";

const here = Astro.url.pathname;

// A section is unfolded when the page is inside it - the drawer opens on
// "Join us" while you are reading a position.
const openHere = (item: (typeof site.nav)[number]) =>
  isActive(here, item.href) || item.children.some((child) => isActive(here, child.href));

// Inside an unfolded section every row would otherwise be lit, since the
// section's own link is a prefix of its children's. One row is the page.
const isHere = (path: string) => (here.replace(/\/$/, "") || "/") === url(path);
---

{/* Sticky, and so also what the drawer below hangs its top edge from. */}
<header class="sticky top-0 z-50 border-b border-border bg-background/85 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center gap-6 px-6 py-4">
    <a
      href={url("/")}
      class="flex items-center gap-2.5 font-display text-sm font-bold tracking-tighter whitespace-nowrap"
    >
      {
        /* Flattened to the theme's ink, so it sits with the wordmark rather
          than against it. */
      }
      <Logo
        label={site.shortTitle}
        name="swarm-mark"
        mono
        size="h-6 w-auto"
        widths={[48, 96]}
        sizes="24px"
        class="shrink-0"
      />
      {site.shortTitle}
    </a>

    <!--
      The full strip of tabs only fits from `md` up. Below that it is replaced
      by the drawer further down, rather than a scrolling strip: a row you have
      to swipe hides half the site from anyone who does not think to try.
    -->
    <nav class="ml-auto hidden items-center gap-5 md:flex" aria-label="Main">
      {
        site.nav.map((item) => {
          const active = isActive(here, item.href);
          // Every tab is laid out the same way, whether or not it carries a
          // chevron: a flex box of its own. Left as inline text, the tab with
          // the drop-down sat a couple of pixels below the others, because an
          // inline element takes its height from the font and the chevron
          // stretched the line box it sat on.
          const linkClass = [
            "flex items-center font-display text-[11px] tracking-widest whitespace-nowrap uppercase transition-colors",
            active ? "text-accent" : "text-muted-foreground hover:text-foreground",
          ];

          // A tab with children keeps its own link and reveals the list on
          // hover or keyboard focus, so it works without JavaScript.
          return item.children.length > 0 ? (
            /* The padding fills the header's own height, so the list drops
               from the header edge and the pointer never crosses a gap. */
            <div class="group relative -my-4 py-4">
              <a
                href={url(item.href)}
                aria-current={active ? "page" : undefined}
                class:list={linkClass}
              >
                {item.label}
                <span class="ml-1 opacity-60 transition-transform group-hover:rotate-180">▾</span>
              </a>
              <ul class="invisible absolute top-full right-0 z-10 min-w-max translate-y-1 border border-border bg-background py-2 opacity-0 shadow-lg transition-[opacity,visibility,transform] group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={url(child.href)}
                      class="block px-4 py-2 font-display text-[11px] tracking-widest whitespace-nowrap text-muted-foreground uppercase transition-colors hover:text-accent"
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ) : (
            <a
              href={url(item.href)}
              aria-current={active ? "page" : undefined}
              class:list={linkClass}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    {
      /* Pinned to the right on a phone, where the tabs are gone; on a wide
        screen the strip above has already taken the free space. */
    }
    <div class="ml-auto flex items-center gap-1 md:ml-0">
      {
        /* Hidden until its script runs, since a toggle that cannot toggle is
          worse than no toggle at all. */
      }
      <button
        type="button"
        data-theme-toggle
        hidden
        aria-label="Switch theme"
        class="grid size-9 shrink-0 place-items-center text-muted-foreground transition-colors hover:text-accent md:-my-1 md:size-7"
      >
        {/* Each icon shows the theme you would switch to. */}
        <svg
          class="size-4 dark:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
        <svg
          class="hidden size-4 dark:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          ></path>
        </svg>
      </button>

      <!--
        The whole phone menu is one <details>: the button is its <summary> and
        the drawer is its body, so it opens, closes, and takes the keyboard on
        its own. No script, and nothing to hide from a visitor without one.
      -->
      <details class="group md:hidden" data-mobile-nav>
        <summary
          class="grid size-9 cursor-pointer list-none place-items-center text-muted-foreground transition-colors hover:text-accent [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <svg
            class="size-5 group-open:hidden"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <svg
            class="hidden size-5 group-open:block"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M6 6l12 12M18 6 6 18"></path>
          </svg>
        </summary>

        {
          /* Hangs from the header rather than from the button, so it spans the
            screen; capped at the viewport so a long list scrolls instead of
            running off the bottom. */
        }
        <nav
          class="absolute inset-x-0 top-full max-h-[calc(100dvh-4rem)] overflow-y-auto border-b border-border bg-background shadow-lg"
          aria-label="Main"
        >
          <ul class="divide-y divide-border px-6 py-1">
            {
              site.nav.map((item) => {
                const active = isActive(here, item.href);
                const rowClass = [
                  "flex items-center py-3.5 font-display text-xs tracking-widest uppercase transition-colors",
                  active ? "text-accent" : "text-foreground",
                ];

                // A section with children folds open in place, so the drawer
                // stays one screen instead of becoming a second level to walk
                // into. It starts open on the section you are already reading.
                return item.children.length > 0 ? (
                  <li>
                    <details class="group/sub" open={openHere(item)}>
                      <summary
                        class:list={[
                          ...rowClass,
                          "cursor-pointer list-none [&::-webkit-details-marker]:hidden",
                        ]}
                      >
                        {item.label}
                        <span class="ml-auto opacity-60 transition-transform group-open/sub:rotate-180">
                          ▾
                        </span>
                      </summary>
                      <ul class="pb-2 pl-4">
                        {[{ label: "Overview", href: item.href }, ...item.children].map((child) => {
                          const childActive = isHere(child.href);
                          return (
                            <li>
                              <a
                                href={url(child.href)}
                                aria-current={childActive ? "page" : undefined}
                                class:list={[
                                  "block py-2.5 font-display text-[11px] tracking-widest uppercase transition-colors",
                                  childActive ? "text-accent" : "text-muted-foreground",
                                ]}
                              >
                                {child.label}
                              </a>
                            </li>
                          );
                        })}
                      </ul>
                    </details>
                  </li>
                ) : (
                  <li>
                    <a
                      href={url(item.href)}
                      aria-current={active ? "page" : undefined}
                      class:list={rowClass}
                    >
                      {item.label}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // The theme itself is set in <head> before the first paint; this only lets
  // someone change it, and remembers what they chose.
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");

  if (button) {
    const describe = () =>
      root.dataset.theme === "dark" ? "Switch to the light theme" : "Switch to the dark theme";

    button.hidden = false;
    button.setAttribute("aria-label", describe());

    button.addEventListener("click", () => {
      const next = root.dataset.theme === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      button.setAttribute("aria-label", describe());
      // Keeps the browser's own chrome - the address bar on a phone - in step.
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute("content", next === "dark" ? "#09090b" : "#ffffff");
      try {
        localStorage.setItem("theme", next);
      } catch {}
    });
  }

  // The drawer closes itself on the ways out that the markup cannot see: a tap
  // on the page behind it, Escape, or a window grown wide enough for the tabs.
  const drawer = document.querySelector<HTMLDetailsElement>("[data-mobile-nav]");

  if (drawer) {
    const close = () => {
      drawer.open = false;
    };

    // Anywhere outside the header, rather than outside the drawer itself, so
    // that changing the theme with the menu open does not shut it.
    const bar = drawer.closest("header");

    document.addEventListener("pointerdown", (event) => {
      if (drawer.open && !bar?.contains(event.target as Node)) close();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") close();
    });
    window.matchMedia("(min-width: 48rem)").addEventListener("change", (event) => {
      if (event.matches) close();
    });
  }
</script>
