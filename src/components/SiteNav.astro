---
import { site } from "@/lib/data";
import { url, isActive } from "@/lib/url";

const here = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-border bg-background/85 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center gap-6 px-6 py-4">
    <a href={url("/")} class="font-display text-sm font-bold tracking-tighter whitespace-nowrap">
      {site.shortTitle}
    </a>

    <!--
      The strip scrolls on narrow screens, but scrolling makes it a clipping
      box, which would swallow the drop-down. Above `md` there is room for
      every tab, so the overflow is released and the list can escape.
    -->
    <nav
      class="no-scrollbar ml-auto flex items-center gap-5 overflow-x-auto md:overflow-visible"
      aria-label="Main"
    >
      {
        site.nav.map((item) => {
          const active = isActive(here, item.href);
          // Every tab is laid out the same way, whether or not it carries a
          // chevron: a flex box of its own. Left as inline text, the tab with
          // the drop-down sat a couple of pixels below the others, because an
          // inline element takes its height from the font and the chevron
          // stretched the line box it sat on.
          const linkClass = [
            "flex items-center font-display text-[11px] tracking-widest whitespace-nowrap uppercase transition-colors",
            active ? "text-accent" : "text-muted-foreground hover:text-foreground",
          ];

          // A tab with children keeps its own link and reveals the list on
          // hover or keyboard focus, so it works without JavaScript.
          return item.children.length > 0 ? (
            /* The padding fills the header's own height, so the list drops
               from the header edge and the pointer never crosses a gap. */
            <div class="group relative -my-4 py-4">
              <a
                href={url(item.href)}
                aria-current={active ? "page" : undefined}
                class:list={linkClass}
              >
                {item.label}
                <span class="ml-1 opacity-60 transition-transform group-hover:rotate-180">▾</span>
              </a>
              <ul class="invisible absolute top-full right-0 z-10 min-w-max translate-y-1 border border-border bg-background py-2 opacity-0 shadow-lg transition-[opacity,visibility,transform] group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={url(child.href)}
                      class="block px-4 py-2 font-display text-[11px] tracking-widest whitespace-nowrap text-muted-foreground uppercase transition-colors hover:text-accent"
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ) : (
            <a
              href={url(item.href)}
              aria-current={active ? "page" : undefined}
              class:list={linkClass}
            >
              {item.label}
            </a>
          );
        })
      }

      {
        /* Hidden until its script runs, since a toggle that cannot toggle is
          worse than no toggle at all. */
      }
      <button
        type="button"
        data-theme-toggle
        hidden
        aria-label="Switch theme"
        class="-my-1 grid size-7 shrink-0 place-items-center text-muted-foreground transition-colors hover:text-accent"
      >
        {/* Each icon shows the theme you would switch to. */}
        <svg
          class="size-4 dark:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
        <svg
          class="hidden size-4 dark:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          ></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  // The theme itself is set in <head> before the first paint; this only lets
  // someone change it, and remembers what they chose.
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");

  if (button) {
    const describe = () =>
      root.dataset.theme === "dark" ? "Switch to the light theme" : "Switch to the dark theme";

    button.hidden = false;
    button.setAttribute("aria-label", describe());

    button.addEventListener("click", () => {
      const next = root.dataset.theme === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      button.setAttribute("aria-label", describe());
      // Keeps the browser's own chrome - the address bar on a phone - in step.
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute("content", next === "dark" ? "#09090b" : "#ffffff");
      try {
        localStorage.setItem("theme", next);
      } catch {}
    });
  }
</script>
